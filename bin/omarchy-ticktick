#!/usr/bin/env python3
"""TickTick client for the Omarchy shell plugin.

Why a CLI and not XMLHttpRequest inside QML: the session token is a
long-lived credential that has to live in a 0600 file rather than in the
shell's process state, TickTick hands it over as a Set-Cookie on a login
endpoint that answers 429 to anything eager, and the write paths are
read-modify-write against the full task object. All three are miserable in
QML and ordinary in Python. The shell only ever runs this and parses JSON.

New OAuth and personal API token sessions use the official Open API.
Explicit browser-cookie and password logins retain the legacy v2 backend.

Commands:
  login [--email ADDR]          authenticate, store the session token
  logout                        forget the token (and any stored password)
  sync                          refresh the on-disk cache the panel reads
  complete TASK_ID              mark a task done
  reopen TASK_ID                mark a done task not-done again
  add TITLE [--due] [--project] create a task
  checkin HABIT [--value N]     check a habit in for a day
  status                        print the cache summary as JSON
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import getpass
import hashlib
import http.client
import json
import os
import ssl
import stat
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import zoneinfo
from datetime import date, datetime, timedelta, timezone

# Omarchy watches every installed plugin file. A local import must not create
# __pycache__ and reload the service in the middle of browser authorization.
sys.dont_write_bytecode = True

DOMAIN = os.environ.get("TICKTICK_DOMAIN", "ticktick.com")
API = f"https://api.{DOMAIN}/api/v2"
OPEN_API = "https://api.ticktick.com/open/v1"

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "omarchy",
    "ticktick",
)
TOKEN_PATH = os.path.join(STATE_DIR, "session.json")
DATA_PATH = os.path.join(STATE_DIR, "data.json")
OUTBOX_PATH = os.path.join(STATE_DIR, "outbox.json")
DRAIN_LOCK_PATH = os.path.join(STATE_DIR, "drain.lock")

USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"
)

# TickTick rejects requests without an x-device header. The id has to stay
# stable across runs or every sync reads as a new device and trips the
# login throttle sooner.
DEVICE_VERSION = 6070

# /batch/check/0 syncs the whole account, so the cap has to hold years of
# tasks — but a cap there must be, or a compromised endpoint can feed an
# endless body straight into memory.
MAX_BODY_BYTES = 8 * 1024 * 1024
MAX_ERROR_BODY_BYTES = 64 * 1024

STATUS_TODO = 0
STATUS_WONT_DO = -1
STATUS_DONE = 2

CHECKIN_UNCHECKED = 0
CHECKIN_FAILED = 1
CHECKIN_DONE = 2


class TickTickError(RuntimeError):
    """Anything that should reach the user as a message rather than a stack."""

    def __init__(
        self,
        message: str,
        auth_required: bool = False,
        status: int | None = None,
        transient: bool = False,
        needs_review: bool = False,
        response_uncertain: bool = False,
    ):
        super().__init__(message)
        self.auth_required = auth_required
        self.status = status
        # Transient failures may be queued only when the operation is safe
        # to replay. Official creates have no proven idempotency contract.
        self.transient = transient
        self.needs_review = needs_review
        # An unreadable official reply is not a provider rejection. Callers
        # decide whether their operation is safe to replay.
        self.response_uncertain = response_uncertain


def is_series_head(task: dict) -> bool:
    """Whether finishing this task has to roll a series forward.

    The series is the task carrying the rule — an RRULE in `repeatFlag`, or,
    for a series that repeats from completion, a non-zero `repeatFrom` with
    no occurrence markers. An occurrence TickTick has already materialised
    links back with `repeatTaskId`, or carries a bare `repeatFirstDate` and
    no rule of its own: it is one dated instance among many, so finishing it
    is an ordinary completion and there is nothing to advance.

    When in doubt the gate says series, not occurrence. A series mistaken
    for an occurrence ends the whole series with a plain write; an
    occurrence mistaken for a series is refused with a message pointing at
    TickTick. The refusal is the safe direction.
    """
    if not isinstance(task, dict):
        return False
    if task.get("repeatTaskId"):
        return False
    repeat_flag = task.get("repeatFlag")
    if repeat_flag and str(repeat_flag).strip():
        return True
    if task.get("repeatFrom") not in (None, "", 0, "0"):
        return task.get("repeatFirstDate") in (None, "")
    return False


# --------------------------------------------------------------------------
# recurrence
#
# TickTick does not complete a recurring task server-side. Its web client
# performs a compound write: it adds a *new* completed occurrence carrying a
# fresh id, and updates the live series back to not-done with its dates moved
# to the next occurrence. Sending only `status = 2` on the series — which is
# what a generic v2 update does — ends the series instead of rolling it
# forward, which is the data loss this section exists to avoid.
#
# The next-occurrence arithmetic therefore has to happen here, in the client.
# It is a deliberate subset of RFC 5545: the parts TickTick's own repeat
# picker can produce. Anything outside that subset raises and the completion
# is refused rather than guessed, because a wrong date silently reschedules
# somebody's real task.

WEEKDAY_CODES = {"MO": 0, "TU": 1, "WE": 2, "TH": 3, "FR": 4, "SA": 5, "SU": 6}
SUPPORTED_FREQ = ("DAILY", "WEEKLY", "MONTHLY", "YEARLY")
SUPPORTED_RRULE_PARTS = (
    "FREQ", "INTERVAL", "BYDAY", "BYMONTHDAY", "BYMONTH", "COUNT", "UNTIL", "WKST",
)
# TickTick's repeatFrom: "2" counts from the day you finish, anything else
# (including the "0" that plain tasks carry) counts from the due date.
REPEAT_FROM_COMPLETION = "2"
# Day-by-day scan bound. Eight years covers every rule the picker can build,
# including "Feb 29 yearly", and stops a malformed rule from spinning.
MAX_OCCURRENCE_SCAN_DAYS = 366 * 8

RECURRENCE_REFUSAL = (
    "This recurring task cannot be rolled forward safely here ({reason}); "
    "complete it in TickTick so its next occurrence is generated."
)


class UnsupportedRecurrence(Exception):
    """The repeat rule falls outside the subset this client computes."""


def _rrule_int(value, default=None, minimum=1):
    if value in (None, ""):
        return default
    try:
        number = int(value)
    except (TypeError, ValueError):
        raise UnsupportedRecurrence("the repeat rule is malformed")
    if number < minimum:
        raise UnsupportedRecurrence("the repeat rule is malformed")
    return number


def _parse_until(value):
    if not value:
        return None
    text = str(value).strip().rstrip("Z")
    for shape in ("%Y%m%dT%H%M%S", "%Y%m%d"):
        try:
            return datetime.strptime(text, shape).date()
        except ValueError:
            continue
    raise UnsupportedRecurrence("the repeat rule has an UNTIL this client cannot read")


def _parse_byday(value, freq):
    """BYDAY entries, optionally ordinal ("3MO", "-1FR") for monthly/yearly."""
    if not value:
        return []
    entries = []
    for raw in value.split(","):
        token = raw.strip()
        if len(token) < 2:
            raise UnsupportedRecurrence("the repeat rule is malformed")
        code, ordinal_text = token[-2:], token[:-2]
        if code not in WEEKDAY_CODES:
            raise UnsupportedRecurrence("the repeat rule is malformed")
        ordinal = None
        if ordinal_text:
            if freq in ("DAILY", "WEEKLY"):
                raise UnsupportedRecurrence(f"ordinal weekdays are not valid for FREQ={freq}")
            try:
                ordinal = int(ordinal_text)
            except ValueError:
                raise UnsupportedRecurrence("the repeat rule is malformed")
            if ordinal == 0 or abs(ordinal) > 5:
                raise UnsupportedRecurrence("the repeat rule is malformed")
        entries.append((ordinal, WEEKDAY_CODES[code]))
    return entries


def _parse_int_list(value, low, high, signed):
    if not value:
        return []
    numbers = []
    for raw in value.split(","):
        try:
            number = int(raw.strip())
        except ValueError:
            raise UnsupportedRecurrence("the repeat rule is malformed")
        if number == 0 or abs(number) < low or abs(number) > high or (number < 0 and not signed):
            raise UnsupportedRecurrence("the repeat rule is malformed")
        numbers.append(number)
    return numbers


def parse_repeat_rule(flag) -> dict:
    """Read a TickTick repeatFlag into the subset this client can advance.

    TickTick also ships non-RFC repeats under an `ERULE:` prefix — lunar
    calendars, Ebbinghaus review spacing. Those are its own scheme, not
    RFC 5545, so they are refused rather than misread as an RRULE.
    """
    text = str(flag or "").strip()
    if not text:
        raise UnsupportedRecurrence("it carries no repeat rule")
    head, separator, body = text.partition(":")
    head = head.strip().upper()
    if not separator or head != "RRULE":
        raise UnsupportedRecurrence(f"{head or 'that'} repeats are not supported")

    parts = {}
    for chunk in body.split(";"):
        if not chunk.strip():
            continue
        key, separator, value = chunk.partition("=")
        key = key.strip().upper()
        if not separator or not key:
            raise UnsupportedRecurrence("the repeat rule is malformed")
        if key not in SUPPORTED_RRULE_PARTS:
            raise UnsupportedRecurrence(f"{key} is not supported")
        parts[key] = value.strip().upper()

    freq = parts.get("FREQ")
    if freq not in SUPPORTED_FREQ:
        raise UnsupportedRecurrence(f"FREQ={freq or '?'} is not supported")

    return {
        "freq": freq,
        "interval": _rrule_int(parts.get("INTERVAL"), 1),
        "count": _rrule_int(parts.get("COUNT"), None),
        "until": _parse_until(parts.get("UNTIL")),
        "wkst": WEEKDAY_CODES.get(parts.get("WKST") or "MO", 0),
        "byday": _parse_byday(parts.get("BYDAY"), freq),
        "bymonthday": _parse_int_list(parts.get("BYMONTHDAY"), 1, 31, signed=True),
        "bymonth": _parse_int_list(parts.get("BYMONTH"), 1, 12, signed=False),
    }


def _month_length(year: int, month: int) -> int:
    if month == 12:
        return 31
    return (date(year, month + 1, 1) - date(year, month, 1)).days


def _add_months(day, months: int):
    total = (day.year * 12 + day.month - 1) + months
    year, month = divmod(total, 12)
    month += 1
    return date(year, month, min(day.day, _month_length(year, month)))


def _week_start(day, wkst: int):
    return day - timedelta(days=(day.weekday() - wkst) % 7)


def _matches_monthday(bymonthday, day) -> bool:
    if not bymonthday:
        return True
    # A negative BYMONTHDAY counts back from the end: -1 is the last day.
    length = _month_length(day.year, day.month)
    return any(
        (number if number > 0 else length + 1 + number) == day.day for number in bymonthday
    )


def _matches_positional(byday, day) -> bool:
    """Ordinal weekday inside the task's month, e.g. "3MO" or "-1FR"."""
    for ordinal, weekday in byday:
        if day.weekday() != weekday:
            continue
        if ordinal is None:
            return True
        if ordinal > 0:
            if (day.day - 1) // 7 + 1 == ordinal:
                return True
        else:
            remaining = (_month_length(day.year, day.month) - day.day) // 7 + 1
            if remaining == -ordinal:
                return True
    return False


def _matches(rule: dict, dtstart, day) -> bool:
    if day < dtstart:
        return False
    if rule["bymonth"] and day.month not in rule["bymonth"]:
        return False

    freq = rule["freq"]
    interval = rule["interval"]
    byday = rule["byday"]

    if freq == "DAILY":
        if (day - dtstart).days % interval:
            return False
        if byday and day.weekday() not in [weekday for _, weekday in byday]:
            return False
        return _matches_monthday(rule["bymonthday"], day)

    if freq == "WEEKLY":
        weeks = (_week_start(day, rule["wkst"]) - _week_start(dtstart, rule["wkst"])).days // 7
        if weeks % interval:
            return False
        if byday:
            return day.weekday() in [weekday for _, weekday in byday]
        return day.weekday() == dtstart.weekday()

    if freq == "MONTHLY":
        if ((day.year - dtstart.year) * 12 + day.month - dtstart.month) % interval:
            return False
        if byday:
            return _matches_positional(byday, day)
        if rule["bymonthday"]:
            return _matches_monthday(rule["bymonthday"], day)
        return day.day == dtstart.day

    # YEARLY
    if (day.year - dtstart.year) % interval:
        return False
    if not rule["bymonth"] and day.month != dtstart.month:
        return False
    if byday:
        return _matches_positional(byday, day)
    if rule["bymonthday"]:
        return _matches_monthday(rule["bymonthday"], day)
    return day.day == dtstart.day


def next_occurrence_date(rule: dict, dtstart, after, excluded=()):
    """The first day the rule fires strictly after `after`.

    A day-by-day scan rather than clever arithmetic: every supported rule
    resolves in at most a few hundred steps, and the scan is the same code
    for all four frequencies, so there is one matcher to get right instead
    of four generators.
    """
    day = after + timedelta(days=1)
    limit = day + timedelta(days=MAX_OCCURRENCE_SCAN_DAYS)
    while day <= limit:
        if _matches(rule, dtstart, day) and day not in excluded:
            return day
        day += timedelta(days=1)
    raise UnsupportedRecurrence("its next occurrence is more than eight years away")


def _excluded_dates(task: dict, zone) -> set:
    """Occurrences already skipped. Landing on one would undo the skip."""
    skipped = set()
    for raw in task.get("exDate") or []:
        stamp = parse_api_time(raw)
        if stamp is not None:
            skipped.add(stamp.astimezone(zone).date())
    return skipped


def _advance_from_completion(rule: dict, dtstart, finished, excluded=()):
    """"Repeat from the day I finish" — one period past the completion date.

    A bare frequency advances by a plain period. A rule that also names days
    cannot: it has to land on a day the rule actually allows, so those scan
    forward from the completion instead. Both are needed, because TickTick
    writes repeatFrom="2" far more widely than its own picker suggests —
    imported birthdays and calendar series carry it alongside a BYMONTH or
    BYDAY. Refusing that combination blocks ordinary tasks, and advancing it
    by a bare period would move a January birthday to whatever today is.

    Either way a skipped occurrence stays skipped: landing on an `exDate`
    would undo the skip, so the bare arithmetic steps past those days just
    as the day-filter scan does.
    """
    if rule["byday"] or rule["bymonthday"] or rule["bymonth"]:
        return next_occurrence_date(rule, dtstart, finished, excluded)
    interval = rule["interval"]
    if rule["freq"] == "DAILY":
        candidate = finished + timedelta(days=interval)
    elif rule["freq"] == "WEEKLY":
        candidate = finished + timedelta(weeks=interval)
    elif rule["freq"] == "MONTHLY":
        candidate = _add_months(finished, interval)
    else:
        candidate = _add_months(finished, 12 * interval)
    while candidate in (excluded or ()):
        candidate += timedelta(days=1)
    return candidate


def _task_zone(task: dict):
    """The zone the task's wall-clock time is written in.

    Whole-day arithmetic has to happen in that zone or a timed task drifts an
    hour across a DST boundary. Falling back to UTC keeps the plugin working
    on a machine without a tz database rather than refusing the completion.
    """
    name = task.get("timeZone")
    if name:
        try:
            return zoneinfo.ZoneInfo(str(name))
        except Exception:  # noqa: BLE001 - a missing zone is not worth failing a completion
            pass
    return timezone.utc


def _shifted_dates(task: dict, zone, delta: timedelta) -> dict:
    """Move start and due by whole days, preserving duration and wall time.

    Also used for a checklist item, which carries a `startDate` of its own
    but takes its all-day flag from the task it belongs to.
    """
    moved = {}
    for key in ("startDate", "dueDate"):
        stamp = parse_api_time(task.get(key))
        if stamp is None:
            continue
        if task.get("isAllDay"):
            # All-day stamps are a literal midnight marker, not an instant.
            moved[key] = to_api_time(stamp + delta)
        else:
            local = stamp.astimezone(zone)
            moved[key] = to_api_time((local.replace(tzinfo=None) + delta).replace(tzinfo=zone))
    return moved


def _with_count(flag: str, count: int) -> str:
    """Rewrite COUNT in place so the remaining rule text stays byte-identical."""
    head, _, body = str(flag).partition(":")
    parts = []
    for chunk in body.split(";"):
        if chunk.partition("=")[0].strip().upper() == "COUNT":
            parts.append(f"COUNT={count}")
        else:
            parts.append(chunk)
    return f"{head}:{';'.join(parts)}"


def _completed_occurrence(task: dict, completed_time: str) -> dict:
    """The finished occurrence, as a new task pointing back at the series.

    It is a clone with a fresh id and every recurrence marker cleared but
    `repeatTaskId`, which is how TickTick links a completed occurrence to the
    series it came from. Checklist and reminder ids are regenerated because
    the originals still belong to the live task.
    """
    occurrence = dict(task)
    occurrence["id"] = object_id()
    occurrence["status"] = STATUS_DONE
    occurrence["completedTime"] = completed_time
    occurrence["modifiedTime"] = completed_time
    occurrence["repeatFlag"] = None
    occurrence["repeatFrom"] = None
    occurrence["repeatFirstDate"] = None
    occurrence["repeatTaskId"] = task.get("id")
    occurrence["parentId"] = None
    occurrence["childIds"] = []
    occurrence["items"] = [dict(item, id=object_id()) for item in task.get("items") or []]
    occurrence["reminders"] = [dict(r, id=object_id()) for r in task.get("reminders") or []]
    # Attachments are server-side files owned by the live task. Copying their
    # ids onto a second task would have two records claiming one upload, so
    # the finished occurrence records the work without them.
    occurrence.pop("attachments", None)
    occurrence.pop("focusSummaries", None)
    return occurrence


def _advanced_series(task: dict, moved: dict, zone, delta: timedelta, completed_time: str, rule: dict) -> dict:
    """The live task, still open, moved on to its next occurrence."""
    series = dict(task)
    series["status"] = STATUS_TODO
    series["completedTime"] = None
    series["modifiedTime"] = completed_time
    series.update(moved)
    # Per-occurrence state does not carry over: last week's ticked subtasks
    # are not this week's, and a subtask dated to the old occurrence has to
    # travel with it or it reads as overdue the moment the task rolls over.
    series["items"] = [
        dict(
            item,
            status=0,
            completedTime=None,
            **_shifted_dates({**item, "isAllDay": task.get("isAllDay")}, zone, delta),
        )
        for item in task.get("items") or []
    ]
    if "progress" in series:
        series["progress"] = 0
    if "focusSummaries" in series:
        series["focusSummaries"] = []
    if rule["count"] is not None:
        series["repeatFlag"] = _with_count(task.get("repeatFlag"), rule["count"] - 1)
    return series


def plan_recurring_completion(task: dict, completed_time: str) -> dict | None:
    """The two objects that finish one occurrence and keep the series alive.

    Returns None when this *is* the last occurrence — an exhausted COUNT or a
    next date past UNTIL. There is nothing to roll forward then, so ordinary
    completion is the correct write rather than a refusal.
    """
    rule = parse_repeat_rule(task.get("repeatFlag"))
    zone = _task_zone(task)

    due = parse_api_time(task.get("dueDate") or task.get("startDate"))
    if due is None:
        raise UnsupportedRecurrence("it has no due date to advance")
    due_local = due.astimezone(zone).date()

    first = parse_api_time(task.get("repeatFirstDate"))
    dtstart = first.astimezone(zone).date() if first else due_local
    if due_local < dtstart:
        dtstart = due_local
    excluded = _excluded_dates(task, zone)

    if str(task.get("repeatFrom") or "") == REPEAT_FROM_COMPLETION:
        finished = parse_api_time(completed_time)
        anchor = (finished or datetime.now(timezone.utc)).astimezone(zone).date()
        # Finishing early must not drag the series backwards. A task dated
        # ahead of today — a birthday, a booking, anything imported with its
        # real date — moves on from its own due date, not from this
        # afternoon, or completing it once rewrites the day it falls on.
        if anchor < due_local:
            anchor = due_local
        next_date = _advance_from_completion(rule, dtstart, anchor, excluded)
    else:
        next_date = next_occurrence_date(rule, dtstart, due_local, excluded)

    if rule["count"] is not None and rule["count"] <= 1:
        return None
    if rule["until"] and next_date > rule["until"]:
        return None

    delta = next_date - due_local
    return {
        "occurrence": _completed_occurrence(task, completed_time),
        "series": _advanced_series(
            task, _shifted_dates(task, zone, delta), zone, delta, completed_time, rule
        ),
    }


def recurring_completion_plan(task: dict, completed_time: str) -> dict | None:
    """`plan_recurring_completion`, with an unsupported rule turned into a refusal."""
    try:
        return plan_recurring_completion(task, completed_time)
    except UnsupportedRecurrence as reason:
        raise TickTickError(RECURRENCE_REFUSAL.format(reason=reason)) from None


def ensure_completion_is_safe(task: dict, status: int) -> None:
    """Refuse a completion this client cannot roll forward correctly.

    Completing a recurring task is a two-object transaction, so the gate is
    not "is it recurring" but "can the next occurrence be computed". A rule
    outside the supported subset stops here instead of reaching a generic v2
    update, which would end the series.
    """
    if status == STATUS_DONE and is_series_head(task):
        recurring_completion_plan(task, now_api_time())


# v2 reports failures in-band as often as by status code, and it picks the
# status code carelessly — bad credentials come back as a 500 carrying a
# perfectly clear errorCode. So the body is what gets trusted, not the code.
AUTH_ERROR_CODES = {
    "user_not_sign_on",
    "not_authenticate",
    "auth_error",
    "token_expired",
}

FRIENDLY_ERRORS = {
    "username_password_not_match": "TickTick rejected that email and password.",
    "user_not_exist": "TickTick has no account for that email.",
    "need_captcha": (
        "TickTick wants a captcha before it will accept this login. "
        "Sign in once at https://ticktick.com/signin, then retry."
    ),
    "captcha_error": (
        "TickTick wants a captcha before it will accept this login. "
        "Sign in once at https://ticktick.com/signin, then retry."
    ),
    "too_many_login_attempts": "Too many login attempts. Wait a few minutes.",
}


def raise_for_payload(payload: dict, path: str) -> None:
    """Turn a v2 error body into a TickTickError, or return quietly."""
    code = str(payload.get("errorCode") or "")
    if not code and "errorId" not in payload:
        return

    if code in AUTH_ERROR_CODES:
        raise TickTickError(
            "TickTick rejected the stored session. Run: omarchy-ticktick login",
            auth_required=True,
        )
    if code in FRIENDLY_ERRORS:
        raise TickTickError(FRIENDLY_ERRORS[code])

    # Arbitrary server text can echo a submitted cookie/password. Keep known
    # friendly messages above, but never copy an untrusted error body to logs.
    raise TickTickError(f"TickTick rejected the request on {path}")


# --------------------------------------------------------------------------
# state files


@contextlib.contextmanager
def _ensure_state_dir():
    """Pin an owned, 0700 directory, refusing symlinks in the entire path.

    Resolve one component at a time with directory fds so permission checks
    and subsequent writes address the same directory, not a swapped symlink.
    Ancestors may be shared; only the credential directory is chmodded.
    """
    directory = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        try:
            for component in os.path.abspath(STATE_DIR).split(os.sep)[1:]:
                try:
                    os.mkdir(component, mode=0o700, dir_fd=directory)
                except FileExistsError:
                    pass
                child = os.open(
                    component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                    dir_fd=directory,
                )
                os.close(directory)
                directory = child
            if os.fstat(directory).st_uid != os.getuid():
                raise TickTickError("TickTick credential directory must be owned by the current user")
            os.fchmod(directory, 0o700)
            if stat.S_IMODE(os.fstat(directory).st_mode) != 0o700:
                raise TickTickError("TickTick credential directory must have mode 0700")
        except OSError:
            raise TickTickError(
                "Cannot secure TickTick credential directory; check permissions and remove unsafe symlinks"
            ) from None
        yield directory
    finally:
        os.close(directory)


def _write_private(path: str, payload: dict) -> None:
    """Write JSON atomically, with an exclusive 0600 temp from the outset."""
    with _ensure_state_dir() as directory:
        name = os.path.basename(path)
        tmp = f".{name}.{os.urandom(12).hex()}.tmp"
        fd = os.open(
            tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600, dir_fd=directory,
        )
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                json.dump(payload, handle, separators=(",", ":"))
            os.replace(tmp, name, src_dir_fd=directory, dst_dir_fd=directory)
        finally:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(tmp, dir_fd=directory)


def _read_json(path: str) -> dict:
    try:
        with _ensure_state_dir() as directory:
            fd = os.open(
                os.path.basename(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                dir_fd=directory,
            )
            with os.fdopen(fd, encoding="utf-8") as handle:
                info = os.fstat(handle.fileno())
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
                    return {}
                return json.load(handle)
    except (OSError, ValueError):
        return {}


def load_session() -> dict:
    return _read_json(TOKEN_PATH)


def device_id(session: dict) -> str:
    stored = session.get("deviceId")
    if isinstance(stored, str) and len(stored) == 24:
        return stored
    return os.urandom(12).hex()


def object_id() -> str:
    """TickTick ids are Mongo ObjectIds and v2 batch/add wants a client-made one."""
    return os.urandom(12).hex()


# --------------------------------------------------------------------------
# http


def _valid_token(token) -> bool:
    # http.client includes malformed header values in exceptions. Reject them
    # without echoing the credential before they can reach that error path.
    return (isinstance(token, str) and 0 < len(token) <= 4096
            and all(0x21 <= ord(char) <= 0x7e for char in token))


def _headers(session: dict, with_token: bool = True) -> dict:
    if session.get("backend") == "openapi":
        headers = {"Content-Type": "application/json", "Accept": "application/json",
                   "User-Agent": "omarchy-ticktick"}
        if with_token:
            token = session.get("token")
            if not _valid_token(token):
                raise TickTickError("Stored TickTick access token is malformed; reconnect", auth_required=True)
            headers["Authorization"] = f"Bearer {token}"
        return headers
    # Kept deliberately minimal. A fuller field set copied from TickTick's own
    # web bundle, and any Origin/Referer pair, both make the edge answer
    # access_forbidden — it blocks requests that claim to be the web app
    # without being it. This short form is the one that reaches the actual
    # credential check.
    device = {
        "platform": "web",
        "os": "Linux",
        "device": "Firefox 128.0",
        "name": "",
        "version": DEVICE_VERSION,
        "id": device_id(session),
        "channel": "website",
        "campaign": "",
        "websocket": "",
    }
    headers = {
        "Content-Type": "application/json",
        "User-Agent": USER_AGENT,
        "x-device": json.dumps(device, separators=(",", ":")),
        "Accept": "application/json",
        # No Origin/Referer on purpose. Sending them makes TickTick's edge
        # answer access_forbidden — it treats a browser-claiming request that
        # is not actually a browser as forged. Measured, not guessed.
    }
    token = session.get("token")
    if with_token and token:
        if not _valid_token(token):
            raise TickTickError("Stored TickTick token is malformed; paste a fresh token", auth_required=True)
        headers["Cookie"] = f"t={token}"
    return headers


class _NoRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        # Cookies and password bodies must never be forwarded, even to another
        # port on the same host. Normal v2 API calls do not need redirects.
        return None


def request(
    method: str,
    path: str,
    session: dict,
    payload: dict | None = None,
    params: dict | None = None,
    with_token: bool = True,
    timeout: int = 20,
) -> dict | list:
    official = session.get("backend") == "openapi"
    base = OPEN_API if official else API
    url = f"{base}{path}"
    if params:
        url = f"{url}?{urllib.parse.urlencode(params)}"

    if urllib.parse.urlsplit(url).scheme != "https":
        raise TickTickError("Refusing to send TickTick credentials over non-HTTPS transport")
    if official:
        parsed_url = urllib.parse.urlsplit(url)
        if (parsed_url.netloc != "api.ticktick.com" or not path.startswith("/")
                or "?" in path or "#" in path or ".." in path.split("/")
                or not parsed_url.path.startswith("/open/v1/")
                or path.split("/")[1] not in ("preference", "project", "task", "tag", "habit", "focus")):
            raise TickTickError("Refusing an unsafe TickTick Open API destination")

    body = None if payload is None else json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=body, method=method, headers=_headers(session, with_token))
    opener = urllib.request.build_opener(
        _NoRedirects(), urllib.request.HTTPSHandler(context=ssl.create_default_context())
    )

    try:
        with opener.open(req, timeout=timeout) as response:
            raw_bytes = response.read(MAX_BODY_BYTES + 1)
            if len(raw_bytes) > MAX_BODY_BYTES:
                raise TickTickError(
                    f"Response from {path} exceeded {MAX_BODY_BYTES // (1024 * 1024)} MB; "
                    "refusing to buffer it", response_uncertain=official,
                )
            if official and response.headers.get("Content-Length") is not None:
                length = response.headers["Content-Length"].strip()
                # Bounded HTTPResponse.read(n) may silently return a short
                # body, even syntactically valid JSON, without IncompleteRead.
                # Compare decimal text without converting an untrusted integer.
                if (not length.isascii() or not length.isdecimal()
                        or (length.lstrip("0") or "0") != str(len(raw_bytes))):
                    raise TickTickError("TickTick returned an incomplete response body",
                                        response_uncertain=True)
            raw = raw_bytes.decode("utf-8").strip()
    except urllib.error.HTTPError as error:
        if 300 <= error.code < 400:
            error.close()
            raise TickTickError("TickTick API redirect refused", status=error.code) from None
        body = ""
        try:
            body = error.read(MAX_ERROR_BODY_BYTES).decode("utf-8", "replace").strip()
        except Exception:  # noqa: BLE001 - the status matters, not the read failure
            pass
        finally:
            error.close()

        # The body outranks the status code here: a wrong password arrives as
        # a 500 with errorCode username_password_not_match, and reporting that
        # as "HTTP 500" would send the user hunting a server outage.
        try:
            parsed_error = json.loads(body)
        except ValueError:
            parsed_error = None
        if not official and isinstance(parsed_error, dict):
            raise_for_payload(parsed_error, path)

        if error.code in (401, 403):
            raise TickTickError(
                "TickTick rejected the stored session. Run: omarchy-ticktick login",
                auth_required=True,
                status=error.code,
            ) from error
        if error.code == 429:
            raise TickTickError(
                "TickTick is rate limiting this account. Wait a few minutes.",
                status=429,
                transient=True,
            ) from error
        if error.code == 404:
            raise TickTickError(
                ("TickTick could not find that Open API resource." if official else
                 f"TickTick has no endpoint at {path} — the v2 API moved. This plugin needs updating."),
                status=404,
            ) from error
        raise TickTickError(f"HTTP {error.code} from {path}", status=error.code,
                            transient=official and error.code >= 500) from None
    except urllib.error.URLError as error:
        raise TickTickError(
            "Network error talking to TickTick", transient=True
        ) from None
    except TimeoutError as error:
        raise TickTickError("TickTick timed out", transient=True) from error
    except (http.client.HTTPException, OSError):
        if not official:
            raise
        # read() can fail after a committed POST (IncompleteRead, reset,
        # aborted TLS, etc.). Never propagate partial bytes or peer text.
        raise TickTickError("TickTick response was interrupted", transient=True,
                            response_uncertain=True) from None
    except UnicodeError:
        raise TickTickError("TickTick returned an invalid response encoding",
                            response_uncertain=official) from None

    if not raw:
        return {}
    try:
        parsed = json.loads(raw)
    except (ValueError, RecursionError) as error:
        if official:
            raise TickTickError("TickTick returned an invalid JSON response",
                                response_uncertain=True) from None
        if isinstance(error, RecursionError):
            raise
        raise TickTickError(f"Malformed JSON from {path}") from error

    # v2 signals failures in-band with a 200 as often as with a status code.
    if isinstance(parsed, dict):
        raise_for_payload(parsed, path)
        if official and (parsed.get("error") or parsed.get("id2error")):
            raise TickTickError("TickTick rejected the Open API request")

    return parsed


# --------------------------------------------------------------------------
# auth


def sign_in(email: str, password: str, session: dict) -> dict:
    """Exchange credentials for a session token.

    The path is `signon`, not `signin` — `signin` is a dead 404 that several
    published wrappers still point at.

    This endpoint is throttled hard — a 429 here is TickTick telling us to
    stop, not a transient blip, so it is not retried in a loop.
    """
    response = request(
        "POST",
        "/user/signon",
        session,
        payload={"username": email, "password": password},
        params={"wc": "true", "remember": "true"},
        with_token=False,
    )
    token = response.get("token") if isinstance(response, dict) else None
    if not token:
        raise TickTickError("Login succeeded but returned no token")

    return {
        "token": token,
        "userId": response.get("userId", ""),
        "email": email,
        "deviceId": device_id(session),
        "savedAt": int(time.time() * 1000),
    }


def authed_session() -> dict:
    session = load_session()
    if not session.get("token"):
        raise TickTickError(
            "Not signed in to TickTick. Run: omarchy-ticktick login",
            auth_required=True,
        )
    if (session.get("backend") == "openapi" and session.get("expiresAt")
            and session["expiresAt"] <= int(time.time() * 1000)):
        raise TickTickError("TickTick authorization expired; reconnect", auth_required=True)
    return session


def with_session(call):
    """Run an API call against the stored session.

    This used to retry by logging in again with a saved password. TickTick's
    risk control refuses scripted password logins, so the retry never had
    anything usable to retry with — it wrapped every call in a recovery that
    could not happen. An expired session now surfaces as an auth error, which
    the panel already turns into "paste a fresh token".
    """
    with account_lock():
        session = authed_session()
        try:
            return call(session), session
        except TickTickError as error:
            error.session = session
            raise


def session_owner(session: dict) -> str:
    if not session.get("token"):
        return ""
    value = f"{session.get('backend', 'v2')}:{session['token']}"
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


@contextlib.contextmanager
def account_lock():
    # A separate lock from the outbox drain lets login coexist with sync
    # without adopting another account while a mutation is in flight.
    with _ensure_state_dir() as directory:
        fd = os.open("session.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
                     0o600, dir_fd=directory)
    with os.fdopen(fd, "w") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def ensure_session_switch_safe(candidate: dict) -> None:
    if read_outbox() and session_owner(candidate) != session_owner(load_session()):
        raise TickTickError(
            "Pending changes belong to the current TickTick connection. Sync them with that "
            "connection before changing account, token, or backend; the cache and outbox were preserved."
        )


# --------------------------------------------------------------------------
# time helpers


def to_api_time(stamp: datetime) -> str:
    """TickTick's wire format: UTC, milliseconds, numeric offset."""
    stamp = stamp.astimezone(timezone.utc)
    return stamp.strftime("%Y-%m-%dT%H:%M:%S.") + f"{stamp.microsecond // 1000:03d}+0000"


def now_api_time() -> str:
    return to_api_time(datetime.now(timezone.utc))


def date_stamp(when: datetime | None = None) -> int:
    """Habit check-ins are keyed by a local YYYYMMDD integer, not a timestamp."""
    return int((when or datetime.now()).strftime("%Y%m%d"))


def parse_api_time(value: str | None) -> datetime | None:
    if not value:
        return None
    text = str(value).strip()
    # "2026-08-12T04:00:00.000+0000" — Python wants "+00:00".
    if len(text) >= 5 and (text[-5] in "+-") and text[-3] != ":":
        text = f"{text[:-2]}:{text[-2:]}"
    if text.endswith("Z"):
        text = f"{text[:-1]}+00:00"
    try:
        return datetime.fromisoformat(text)
    except ValueError:
        return None


# --------------------------------------------------------------------------
# outbox
#
# Legacy writes carry client-generated ids. Official task/focus creates do
# not preserve those ids, so unconfirmed creates are retained for review,
# never replayed. Updates still target an existing record or check-in date.


def read_outbox() -> list:
    data = _read_json(OUTBOX_PATH)
    entries = data.get("entries") if isinstance(data, dict) else None
    return entries if isinstance(entries, list) else []


def write_outbox(entries: list) -> None:
    _write_private(OUTBOX_PATH, {"version": 1, "entries": entries})


def queue_write(kind: str, payload: dict, reason: str, session: dict | None = None) -> dict:
    """Retain a pending write, applying only safe optimistic changes locally.

    Applying to the cache immediately is the point: the queued change stays
    visible across a shell restart instead of living only in the panel's
    memory, where a restart would lose it silently.
    """
    with account_lock():
        current = load_session()
        if session is not None and session_owner(session) != session_owner(current):
            raise TickTickError("TickTick connection changed before the write could be queued; retry the action")
        entry = {
            "id": object_id(),
            "kind": kind,
            "payload": payload,
            "queuedAt": int(time.time() * 1000),
            "attempts": 0,
            "lastError": reason,
            "owner": session_owner(current),
            "backend": current.get("backend", "v2"),
        }
        write_outbox(read_outbox() + [entry])
        apply_locally(kind, payload)
    return entry


def apply_locally(kind: str, payload: dict) -> None:
    """Mirror a queued write into the cache the panel reads."""
    cache = _read_json(DATA_PATH)
    if not cache:
        return
    if payload.get("needsReview"):
        cache["queued"] = len(read_outbox())
        _write_private(DATA_PATH, cache)
        return

    if kind == "add":
        if not payload.get("needsReview"):
            tasks = cache.setdefault("tasks", [])
            if not any(task.get("id") == payload["task"].get("id") for task in tasks):
                tasks.append(payload["task"])

    elif kind in ("complete", "reopen"):
        target = STATUS_DONE if kind == "complete" else STATUS_TODO
        for index, task in enumerate(cache.get("tasks", [])):
            if task.get("id") != payload["taskId"]:
                continue
            plan = None
            if target == STATUS_DONE and is_series_head(task) and cache.get("backend") != "openapi":
                # Mirror the transaction the replay will send, so the panel
                # shows the next occurrence rather than a vanished task.
                with contextlib.suppress(TickTickError):
                    plan = recurring_completion_plan(
                        task, payload.get("completedTime") or now_api_time()
                    )
            if plan is not None:
                cache["tasks"][index] = plan["series"]
                cache["tasks"].append(plan["occurrence"])
            else:
                task["status"] = target
            break

    elif kind == "update":
        for i, task in enumerate(cache.get("tasks", [])):
            if task.get("id") == payload["taskId"]:
                cache["tasks"][i] = apply_edit(task, payload["fields"])
                break

    elif kind == "subtask":
        for task in cache.get("tasks", []):
            if task.get("id") == payload["taskId"]:
                if payload.get("item"):
                    for item in task.get("items") or []:
                        if item.get("id") == payload["itemId"]:
                            item["status"] = payload["item"]["status"]
                            if payload["item"].get("completedTime"):
                                item["completedTime"] = payload["item"]["completedTime"]
                            else:
                                item.pop("completedTime", None)
                            break
                else:
                    flip_subtask(task, payload["itemId"])
                break

    elif kind == "checkin":
        entry = payload["entry"]
        habit_id = entry["habitId"]
        entries = cache.setdefault("checkins", {}).setdefault(habit_id, [])
        for i, existing in enumerate(entries):
            if existing.get("checkinStamp") == entry["checkinStamp"]:
                entries[i] = entry
                break
        else:
            entries.append(entry)

    elif kind == "pomo":
        if not payload.get("needsReview"):
            stats = cache.setdefault("pomoStats", {})
            minutes = payload.get("minutes", 0)
            stats["todayPomoCount"] = int(stats.get("todayPomoCount", 0)) + 1
            stats["todayPomoDuration"] = int(stats.get("todayPomoDuration", 0)) + int(minutes)

    cache["queued"] = len(read_outbox())
    _write_private(DATA_PATH, cache)


def replay(entry: dict, session: dict) -> None:
    """Send one queued write, resolving it against current server state.

    A v2 update is a whole-object write, so replaying a stale copy of a task
    would undo anything changed elsewhere since it was queued. Each replay
    therefore re-fetches the record and changes only the field the user
    actually acted on.
    """
    kind = entry.get("kind")
    payload = entry.get("payload") or {}
    if (entry.get("owner") and entry["owner"] != session_owner(session)) or (
        entry.get("backend", "v2") != session.get("backend", "v2")
    ):
        raise TickTickError("Queued changes belong to a different TickTick connection; outbox preserved")
    if session.get("backend") == "openapi":
        return replay_openapi(kind, payload, session)

    if kind == "add":
        batch_task(session, add=[payload["task"]])

    elif kind in ("complete", "reopen"):
        task = dict(find_task(payload["taskId"], session))
        target = STATUS_DONE if kind == "complete" else STATUS_TODO
        if target == STATUS_DONE and is_series_head(task):
            # Recomputed against the record as it stands now, not as it stood
            # when the write was queued — the series may have moved since.
            plan = recurring_completion_plan(task, payload.get("completedTime") or now_api_time())
            if plan is not None:
                batch_task(session, add=[plan["occurrence"]], update=[plan["series"]])
                return
        ensure_completion_is_safe(task, target)
        task["status"] = target
        if kind == "complete":
            task["completedTime"] = payload.get("completedTime") or now_api_time()
        else:
            task.pop("completedTime", None)
        batch_task(session, update=[task])

    elif kind == "update":
        task = find_task(payload["taskId"], session)
        batch_task(session, update=[apply_edit(task, payload["fields"])])

    elif kind == "subtask":
        task = dict(find_task(payload["taskId"], session))
        if not flip_subtask(task, payload["itemId"]):
            # The subtask is gone server-side — edited away elsewhere while
            # this write sat queued. Delivering nothing is the faithful
            # replay; there is no checkbox left to set.
            return
        task["modifiedTime"] = now_api_time()
        batch_task(session, update=[task])

    elif kind == "checkin":
        entry_payload = dict(payload["entry"])
        existing = query_checkin(session, entry_payload["habitId"], entry_payload["checkinStamp"])
        body = {"add": [], "update": [], "delete": []}
        if existing and existing.get("id"):
            entry_payload["id"] = existing["id"]
            body["update"].append(entry_payload)
        else:
            entry_payload.pop("id", None)
            body["add"].append(entry_payload)
        request("POST", "/habitCheckins/batch", session, payload=body)

    elif kind == "pomo":
        request(
            "POST",
            "/batch/pomodoro",
            session,
            payload={"add": [payload["entry"]], "update": [], "delete": []},
        )

    else:
        raise TickTickError(f"Unknown queued action {kind!r}")


@contextlib.contextmanager
def drain_lock():
    """Hold the exclusive right to deliver queued writes, or yield False.

    A bar surface exists per monitor, so two panels can sync at the same
    instant. Without this both replay the same entry: measured, both reported
    sending it. Adds survive that because their id is generated client-side,
    but a queued check-in takes the add path with no id and would insert
    twice. Whoever loses the race simply skips — the winner is already doing
    the work.
    """
    with _ensure_state_dir() as directory:
        fd = os.open(
            os.path.basename(DRAIN_LOCK_PATH),
            os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
            0o600, dir_fd=directory,
        )
    handle = os.fdopen(fd, "w")
    try:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            yield False
            return
        try:
            yield True
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)
    finally:
        handle.close()


def drain_outbox(session: dict) -> dict:
    """Replay everything queued, oldest first. Stops at the first outage."""
    entries = read_outbox()
    if not entries:
        return {"sent": 0, "queued": 0, "dropped": 0}
    for entry in entries:
        if ((entry.get("owner") and entry["owner"] != session_owner(session))
                or entry.get("backend", "v2") != session.get("backend", "v2")):
            raise TickTickError("Queued changes belong to a different TickTick connection; outbox preserved")

    remaining, sent, dropped = [], 0, 0
    stalled = False

    for entry in entries:
        if stalled:
            remaining.append(entry)
            continue
        try:
            replay(entry, session)
            sent += 1
        except TickTickError as error:
            entry["attempts"] = int(entry.get("attempts", 0)) + 1
            entry["lastError"] = str(error)
            if error.transient or error.auth_required or session.get("backend") == "openapi":
                # Still offline. Keep the rest queued and preserve order
                # rather than hammering a dead network once per entry.
                remaining.append(entry)
                stalled = True
            else:
                # A rejection will be rejected again forever. Dropping it is
                # the only way the queue ever empties, so it is surfaced.
                dropped += 1

    write_outbox(remaining)
    return {"sent": sent, "queued": len(remaining), "dropped": dropped}


# --------------------------------------------------------------------------
# reads


def fetch_state(session: dict, scope: str = "full") -> dict:
    """One sync round: tasks, projects, habits, and this month's check-ins.

    `scope` exists because a write costs a sync, and a full sync is five
    round trips. Adding a task cannot change your habits, your check-ins, or
    your pomodoro settings, so re-fetching them afterwards is a second and a
    half spent confirming that nothing happened. Sections outside the scope
    are carried over from the cache untouched.
    """
    if session.get("backend") == "openapi":
        return fetch_openapi_state(session, scope)
    previous = _read_json(DATA_PATH)
    if previous.get("cacheOwner") and previous["cacheOwner"] != session_owner(session):
        previous = {}
    want_tasks = scope in ("full", "tasks")
    want_habits = scope in ("full", "habits")
    want_pomo = scope in ("full", "pomo")

    if not want_tasks:
        tasks = previous.get("tasks", [])
        projects = previous.get("projects", [])
        tags = previous.get("tags", [])
        inbox_id = previous.get("inboxId", "")
    else:
        batch = request("GET", "/batch/check/0", session)
        if not isinstance(batch, dict):
            raise TickTickError("Unexpected shape from batch/check/0")

        raw_tasks = (batch.get("syncTaskBean") or {}).get("update") or []
        tasks = [t for t in raw_tasks if isinstance(t, dict) and not t.get("deleted")]
        projects = [
            {
                "id": p.get("id"),
                "name": p.get("name"),
                "color": p.get("color"),
                "closed": bool(p.get("closed")),
            }
            for p in (batch.get("projectProfiles") or [])
            if isinstance(p, dict)
        ]
        # Tags are the one place TickTick actually stores a colour the user
        # picked. Tasks reference them by `name`, the lowercase key; `label`
        # is what gets shown.
        tags = [
            {"name": t.get("name"), "label": t.get("label"), "color": t.get("color")}
            for t in (batch.get("tags") or [])
            if isinstance(t, dict) and t.get("name")
        ]
        inbox_id = batch.get("inboxId", "")

    if not want_habits:
        active_habits = previous.get("habits", [])
        checkins = previous.get("checkins", {})
    else:
        habits = request("GET", "/habits", session)
        if not isinstance(habits, list):
            habits = []
        active_habits = [h for h in habits if h.get("status", 0) == 0]

        checkins = {}
        habit_ids = [h["id"] for h in active_habits if h.get("id")]
        if habit_ids:
            # 60 days back is enough to draw a streak without pulling a
            # decade of history on every sync.
            after = date_stamp(datetime.now() - timedelta(days=60))
            response = request(
                "POST",
                "/habitCheckins/query",
                session,
                payload={"habitIds": habit_ids, "afterStamp": after},
            )
            if isinstance(response, dict):
                checkins = response.get("checkins") or {}

    # Pomodoro is best-effort: it is a secondary panel section, and losing it
    # to a hiccup should not cost the caller their tasks and habits.
    pomo_stats: dict = previous.get("pomoStats", {})
    pomo_prefs: dict = previous.get("pomoPrefs", {})
    try:
        if not want_pomo:
            raise StopIteration
        stats = request("GET", "/pomodoros/statistics/generalForDesktop", session)
        if isinstance(stats, dict):
            pomo_stats = stats
        prefs = request("GET", "/user/preferences/pomodoro", session)
        if isinstance(prefs, dict):
            pomo_prefs = prefs
    except (TickTickError, StopIteration):
        pass

    return {
        "cacheOwner": session_owner(session),
        "backend": "v2",
        "syncedAt": int(time.time() * 1000),
        "scope": scope,
        "inboxId": inbox_id,
        "pomoStats": pomo_stats,
        "pomoPrefs": pomo_prefs,
        "tags": tags,
        "projects": projects,
        "tasks": tasks,
        "habits": active_habits,
        "checkins": checkins,
        "todayStamp": date_stamp(),
        "authRequired": False,
        "error": None,
    }


def write_cache(state: dict) -> None:
    with account_lock():
        if state.get("cacheOwner") and state["cacheOwner"] != session_owner(load_session()):
            raise TickTickError("TickTick connection changed during sync; stale cache was not saved")
        _write_private(DATA_PATH, state)
        if state.get("backend") == "openapi":
            for entry in read_outbox():
                if entry.get("owner") == state.get("cacheOwner"):
                    apply_locally(entry["kind"], entry.get("payload") or {})


def write_error_cache(message: str, auth_required: bool) -> None:
    """Preserve the last good payload; only stamp the failure onto it.

    A network blip should dim the panel, not blank it.
    """
    cache = _read_json(DATA_PATH)
    cache["error"] = message
    cache["authRequired"] = auth_required
    cache["queued"] = len(read_outbox())
    cache["erroredAt"] = int(time.time() * 1000)
    cache.setdefault("tasks", [])
    cache.setdefault("habits", [])
    cache.setdefault("projects", [])
    cache.setdefault("checkins", {})
    _write_private(DATA_PATH, cache)


def cached_task(task_id: str) -> dict:
    for task in _read_json(DATA_PATH).get("tasks", []):
        if task.get("id") == task_id:
            return task
    raise TickTickError(f"Task {task_id} is not in the local cache; sync first")


def find_task(task_id: str, session: dict) -> dict:
    """Locate a task whether it is still open or already completed.

    Reopen has to reach tasks the cache no longer holds — completing one is
    exactly what removes it — so a miss falls back to the completed list.
    Without this, undo is impossible for the action most in need of one.
    """
    if session.get("backend") == "openapi":
        return find_openapi_task(task_id, session)
    try:
        return cached_task(task_id)
    except TickTickError:
        pass

    completed = request("GET", "/project/all/completed", session, params={"limit": 100})
    for task in completed if isinstance(completed, list) else []:
        if task.get("id") == task_id:
            return task
    raise TickTickError(f"Task {task_id} is in neither the cache nor recent completions")


def resolve_habit(needle: str) -> dict:
    habits = _read_json(DATA_PATH).get("habits", [])
    for habit in habits:
        if habit.get("id") == needle:
            return habit
    lowered = needle.strip().lower()
    for habit in habits:
        if str(habit.get("name", "")).strip().lower() == lowered:
            return habit
    raise TickTickError(f"No habit matching {needle!r} in the local cache")


# --------------------------------------------------------------------------
# official Open API adapters


def _api_id(value) -> str:
    if not isinstance(value, str) or not value or value in (".", ".."):
        raise TickTickError("TickTick resource has no usable identifier; sync first")
    return urllib.parse.quote(value, safe="")


def _open_time(value: str) -> str:
    stamp = parse_api_time(value)
    if stamp is None or stamp.tzinfo is None:
        raise TickTickError("TickTick date has no usable time zone")
    return stamp.strftime("%Y-%m-%dT%H:%M:%S%z")


def _objects(value, resource: str) -> list:
    if not isinstance(value, list) or any(not isinstance(item, dict) for item in value):
        raise TickTickError(f"Unexpected Open API {resource} response")
    return value


def normalize_openapi_checkins(rows) -> dict:
    result = {}
    for row in _objects(rows, "habit check-ins"):
        habit_id = row.get("habitId")
        if not habit_id:
            raise TickTickError("Open API check-in response has no habit identifier")
        entries = result.setdefault(habit_id, [])
        for item in _objects(row.get("checkins"), "habit check-in entries"):
            if "stamp" not in item:
                raise TickTickError("Open API check-in response has no date stamp")
            normalized = dict(item, habitId=habit_id, checkinStamp=item["stamp"])
            if "time" in item:
                normalized["checkinTime"] = item["time"]
            # These are cache/UI status constants, not provider status codes.
            # The official contract does not enumerate check-in status values.
            normalized["providerStatus"] = item.get("status")
            goal = normalized.setdefault("goal", 1.0)
            value = normalized.setdefault("value", 1.0)
            normalized["status"] = CHECKIN_DONE if value >= goal else CHECKIN_UNCHECKED
            entries.append(normalized)
    return result


def fetch_openapi_state(session: dict, scope: str = "full") -> dict:
    previous = _read_json(DATA_PATH)
    if previous.get("cacheOwner") != session_owner(session):
        previous = {}
    prefs = request("POST", "/preference", session)
    if not isinstance(prefs, dict) or not isinstance(prefs.get("timeZone"), str):
        raise TickTickError("Unexpected Open API preferences response")
    warnings = []
    tasks = previous.get("tasks", [])
    projects = previous.get("projects", [])
    tags = previous.get("tags", [])
    if scope in ("full", "tasks"):
        raw_projects = _objects(request("GET", "/project", session), "projects")
        projects = [{key: p[key] for key in ("id", "name", "color", "closed") if key in p}
                    for p in raw_projects]
        by_id = {}
        for project in raw_projects:
            data = request("GET", f"/project/{_api_id(project.get('id'))}/data", session)
            if not isinstance(data, dict):
                raise TickTickError("Unexpected Open API project data response")
            for task in _objects(data.get("tasks"), "project tasks"):
                by_id[task["id"]] = task
        # No inbox id is exposed by the documented preferences/project DTOs.
        # The account-wide filter includes tasks outside the listed projects,
        # but is capped at 200 by the provider and has no pagination contract.
        filtered = _objects(request("POST", "/task/filter", session, payload={"status": [0]}), "tasks")
        for task in filtered:
            by_id[task["id"]] = task
        if len(filtered) >= 200:
            warnings.append("The account-wide task filter reached its 200-task limit; inbox coverage may be incomplete.")
        tasks = list(by_id.values())
        tags = _objects(request("GET", "/tag", session), "tags")
    habits = previous.get("habits", [])
    checkins = previous.get("checkins", {})
    if scope in ("full", "habits"):
        habits = _objects(request("GET", "/habit", session), "habits")
        habits = [habit for habit in habits if not habit.get("archivedTime")]
        habit_ids = [habit["id"] for habit in habits if habit.get("id")]
        checkins = {}
        if habit_ids:
            rows = request("GET", "/habit/checkins", session, params={
                "habitIds": ",".join(habit_ids),
                "from": date_stamp(datetime.now() - timedelta(days=60)), "to": date_stamp(),
            })
            checkins = normalize_openapi_checkins(rows)
    stats = previous.get("pomoStats", {})
    if scope in ("full", "pomo"):
        try:
            zone = zoneinfo.ZoneInfo(prefs["timeZone"])
        except (ValueError, zoneinfo.ZoneInfoNotFoundError):
            raise TickTickError("TickTick returned an unknown account time zone") from None
        now = datetime.now(zone)
        start = now.replace(hour=0, minute=0, second=0, microsecond=0)
        try:
            ended = []
            for focus_type in (0, 1):
                records = _objects(request("GET", "/focus", session, params={
                    "from": _open_time(to_api_time(start)), "to": _open_time(to_api_time(now)),
                    "type": focus_type,
                }), "focus")
                ended.extend(record for record in records if record.get("endTime"))
            # The official CLI specifies focus duration in seconds. Do not
            # interpret undocumented focus status codes or subtract pauses
            # again from a server-provided duration.
            stats = {"todayPomoCount": sum(record.get("type") == 0 for record in ended),
                     "todayPomoDuration": round(sum(record.get("duration", 0) for record in ended) / 60)}
        except TickTickError as error:
            if error.auth_required:
                raise
            warnings.append("Focus statistics could not be refreshed; the last cached values were retained.")
    return {
        "syncedAt": int(time.time() * 1000), "scope": scope,
        "backend": "openapi", "authMethod": session.get("source", "api-token"),
        "cacheOwner": session_owner(session), "timeZone": prefs["timeZone"],
        "inboxId": "", "tasks": tasks, "projects": projects, "tags": tags,
        "habits": habits, "checkins": checkins, "todayStamp": date_stamp(),
        "pomoStats": stats, "pomoPrefs": previous.get("pomoPrefs", {}),
        "capabilities": {"recurringCompletion": True, "focusPreferences": False,
                         "inboxDiscovery": False, "focusStats": "ended-records"},
        "warnings": warnings, "authRequired": False, "error": None,
    }


def find_openapi_task(task_id: str, session: dict) -> dict:
    cache = _read_json(DATA_PATH)
    if cache.get("cacheOwner") == session_owner(session):
        for task in cache.get("tasks", []):
            if task.get("id") == task_id:
                result = request("GET", f"/project/{_api_id(task.get('projectId'))}/task/{_api_id(task_id)}", session)
                if not isinstance(result, dict) or result.get("id") != task_id:
                    raise TickTickError("Unexpected Open API task response")
                return result
    completed = _objects(request("POST", "/task/completed", session, payload={}), "completed tasks")
    for task in completed:
        if task.get("id") == task_id:
            return task
    raise TickTickError("Task is absent from this connection's cache and up to 200 returned completions; sync or use TickTick")


OPEN_TASK_FIELDS = (
    "id", "projectId", "parentId", "title", "content", "desc", "isAllDay", "startDate",
    "dueDate", "timeZone", "reminders", "tags", "repeatFlag", "repeatFrom", "priority", "sortOrder", "items",
)
OPEN_ITEM_FIELDS = ("id", "title", "status", "completedTime", "isAllDay", "sortOrder", "startDate", "timeZone")


def openapi_task_input(task: dict) -> dict:
    body = {key: task[key] for key in OPEN_TASK_FIELDS if key in task}
    for key in ("startDate", "dueDate"):
        if body.get(key):
            body[key] = _open_time(body[key])
    if "items" in body:
        body["items"] = [{key: item[key] for key in OPEN_ITEM_FIELDS if key in item}
                         for item in body["items"]]
        for item in body["items"]:
            for key in ("startDate", "completedTime"):
                if item.get(key):
                    item[key] = _open_time(item[key])
    return body


def openapi_create(path: str, session: dict, body: dict):
    """Send a non-idempotent create once; an uncertain result needs review."""
    try:
        return request("POST", path, session, payload=body)
    except TickTickError as error:
        if error.auth_required or (error.status is not None and 400 <= error.status < 500):
            raise
        if not (error.transient or error.response_uncertain or error.needs_review):
            # A decoded provider rejection (including HTTP 200 error
            # envelopes) is definitive, unlike an unreadable response.
            raise
        # A timeout, lost/malformed response, or server error can follow a
        # committed write. Neither a local id nor a later sync proves which
        # task/focus record it created, so do not turn this into a retry.
        raise TickTickError(
            "Open API creation could not be confirmed; needs review before retrying",
            status=error.status, needs_review=True,
        ) from None


def openapi_create_task(session: dict, task: dict) -> dict:
    body = openapi_task_input(task)
    body.pop("id", None)
    result = openapi_create("/task", session, body)
    if (not isinstance(result, dict) or not isinstance(result.get("id"), str)
            or not result["id"].strip() or result["id"] in (".", "..")):
        raise TickTickError(
            "Open API task creation returned no usable task ID; needs review before retrying",
            needs_review=True,
        )
    return dict(task, **result)


def openapi_status(session: dict, task: dict, status: int) -> dict:
    # The official endpoint rolls the live series forward server-side. This
    # was verified on isolated daily series for both official repeatFrom modes.
    # Never apply v2's differently numbered, client-side recurrence arithmetic.
    recurring = bool(task.get("repeatFlag") or task.get("repeatFrom") not in (None, "", 0, "0"))
    if recurring and status == STATUS_DONE:
        try:
            parse_repeat_rule(task.get("repeatFlag"))
        except UnsupportedRecurrence:
            raise TickTickError("This repeat rule is not supported here; use TickTick for this task") from None
    task_id = _api_id(task.get("id"))
    project_id = _api_id(task.get("projectId"))
    if status == STATUS_DONE:
        try:
            request("POST", f"/project/{project_id}/task/{task_id}/complete", session)
        except TickTickError as error:
            if recurring and (error.transient or error.response_uncertain or error.needs_review):
                raise TickTickError("Recurring completion could not be confirmed; retain it for review before retrying",
                                    needs_review=True) from None
            raise
    elif status == STATUS_TODO:
        request("POST", f"/task/{task_id}", session,
                payload={"id": task["id"], "projectId": task["projectId"], "status": 0})
    else:
        raise TickTickError("Unsupported Open API task status")
    return dict(task, status=status)


def openapi_checkin_body(entry: dict) -> dict:
    return {"stamp": entry["checkinStamp"], "time": _open_time(entry["checkinTime"]),
            "opTime": _open_time(entry["opTime"]), "value": entry["value"], "goal": entry["goal"]}


def replay_openapi(kind: str, payload: dict, session: dict) -> None:
    if payload.get("needsReview"):
        raise TickTickError("This official API write needs review before retrying", needs_review=True)
    if kind in ("complete", "reopen"):
        task = find_task(payload["taskId"], session)
        if "expectedDueDate" in payload:
            actual, expected = task.get("dueDate"), payload["expectedDueDate"]
            if task.get("isAllDay"):
                actual, expected = str(actual or "")[:10], str(expected or "")[:10]
            elif parse_api_time(actual) is not None and parse_api_time(expected) is not None:
                actual, expected = parse_api_time(actual), parse_api_time(expected)
            if actual != expected:
                payload["needsReview"] = True
                raise TickTickError("The recurring occurrence changed while offline; queued completion needs review",
                                    needs_review=True)
        try:
            openapi_status(session, task, STATUS_DONE if kind == "complete" else STATUS_TODO)
        except TickTickError as error:
            if error.needs_review:
                payload["needsReview"] = True
            raise
    elif kind == "add":
        # This includes older entries whose client id was previously assumed
        # to be preserved. We cannot prove whether they already created a task.
        payload["needsReview"] = True
        raise TickTickError("Open API task creation has no safe replay contract; task entry retained for review",
                            needs_review=True)
    elif kind == "update":
        batch_task(session, update=[apply_edit(find_task(payload["taskId"], session), payload["fields"])])
    elif kind == "subtask":
        task = find_task(payload["taskId"], session)
        if not payload.get("item"):
            raise TickTickError("Queued Open API checkbox has no confirmed target state; entry retained for review")
        for item in task.get("items") or []:
            if item.get("id") == payload["itemId"]:
                item["status"] = payload["item"]["status"]
                if payload["item"].get("completedTime"):
                    item["completedTime"] = payload["item"]["completedTime"]
                else:
                    item.pop("completedTime", None)
                batch_task(session, update=[task])
                break
    elif kind == "checkin":
        entry = payload["entry"]
        request("POST", f"/habit/{_api_id(entry['habitId'])}/checkin", session,
                payload=openapi_checkin_body(entry))
    elif kind == "pomo":
        # Official creates have server-generated IDs and no idempotency
        # contract. Such records must not be blindly replayed after timeout.
        raise TickTickError("Open API focus creation has no safe replay contract; focus entry retained for review")
    else:
        raise TickTickError("Unknown queued Open API action")


# --------------------------------------------------------------------------
# writes


def log_pomodoro(start: datetime, end: datetime, pause_seconds: int, pomo_type: int) -> dict:
    """Upload a finished focus session.

    TickTick's own timer runs client-side and only syncs completed sessions,
    so this is the same thing its apps do: build the record locally and push
    it. `tasks` mirrors the outer span — the app fills one entry per task
    worked on, and a session with no task attached still needs the one span
    or the entry does not show in the timeline.
    """
    entry = {
        "id": object_id(),
        "startTime": to_api_time(start),
        "endTime": to_api_time(end),
        "status": 1,
        "pauseDuration": max(0, int(pause_seconds)),
        "type": pomo_type,
        "tasks": [{"startTime": to_api_time(start), "endTime": to_api_time(end)}],
    }

    def call(session):
        if session.get("backend") == "openapi":
            if pomo_type not in (0, 1) or end < start:
                raise TickTickError("Invalid Open API focus type or time range")
            body = {"type": pomo_type, "startTime": _open_time(entry["startTime"]),
                    "endTime": _open_time(entry["endTime"]), "pauseDuration": entry["pauseDuration"]}
            result = openapi_create("/focus", session, body)
            if isinstance(result, dict) and result.get("id"):
                entry["id"] = result["id"]
            else:
                # A documented 201 may have no body; the local reference is
                # not a provider id and must never be used to update focus.
                entry["localOnlyId"] = True
            return result
        return request(
            "POST",
            "/batch/pomodoro",
            session,
            payload={"add": [entry], "update": [], "delete": []},
        )

    try:
        result, _ = with_session(call)
    except TickTickError as error:
        session = getattr(error, "session", None)
        if (session and session.get("backend") == "openapi"
                and (error.transient or error.needs_review)):
            queue_write("pomo", {"entry": entry, "needsReview": True}, str(error), session)
            raise TickTickError(
                "Focus upload could not be confirmed. The session was saved in the outbox for review; "
                "automatic retry could duplicate it. Your local timer remains available.",
                needs_review=True,
            ) from None
        if not error.transient:
            raise
        queue_write(
            "pomo",
            {"entry": entry, "minutes": round((end - start).total_seconds() / 60)},
            str(error),
            session,
        )
        entry["queued"] = True
        return entry
    errors = (result or {}).get("id2error") or {}
    if errors:
        raise TickTickError(f"TickTick rejected the focus session: {errors}")
    return entry


def batch_task(session: dict, add=None, update=None, delete=None) -> dict:
    """Official adds return actual singleton Tasks in `created`; not an ID map.

    Official batches are sequential and may partially succeed. On failure,
    `error.created_tasks` retains confirmed creations; the batch is not safe
    to retry as a unit. Legacy batch requests and responses are unchanged.
    """
    if session.get("backend") == "openapi":
        if delete:
            raise TickTickError("Open API deletions require the task's project")
        created, updated, result = [], [], {}
        try:
            for task in add or []:
                created.append(openapi_create_task(session, task))
            for task in update or []:
                result = request("POST", f"/task/{_api_id(task.get('id'))}", session,
                                 payload=openapi_task_input(task))
                updated.append(result)
        except TickTickError as error:
            error.created_tasks = created
            if created:
                error.transient = False
                error.needs_review = True
            raise
        return {"created": created, "updated": updated} if add else (result if isinstance(result, dict) else {})
    payload = {"add": add or [], "update": update or [], "delete": delete or []}
    result = request("POST", "/batch/task", session, payload=payload)
    return result if isinstance(result, dict) else {}


def set_task_status(task_id: str, status: int) -> dict:
    """Complete or reopen, preserving every other field on the task.

    v2 update is a whole-object write: send a trimmed task and the fields you
    left out are cleared server-side. So the cached object is the base and
    only status/completedTime move.
    """
    holder = {}
    local_task = None

    if status == STATUS_DONE:
        try:
            local_task = cached_task(task_id)
        except TickTickError:
            local_task = None
        if local_task is not None and is_series_head(local_task):
            # Rule-format validation is shared. Backend-specific date math
            # belongs to the dispatched session, never an ambient credential read.
            try:
                parse_repeat_rule(local_task.get("repeatFlag"))
            except UnsupportedRecurrence as reason:
                raise TickTickError(RECURRENCE_REFUSAL.format(reason=reason)) from None

    def call(session):
        task = dict(find_task(task_id, session))
        if session.get("backend") == "openapi":
            holder["task"] = openapi_status(session, task, status)
            return holder["task"]
        if status == STATUS_DONE and is_series_head(task):
            plan = recurring_completion_plan(task, now_api_time())
            if plan is not None:
                holder["task"] = plan["series"]
                return batch_task(session, add=[plan["occurrence"]], update=[plan["series"]])
        ensure_completion_is_safe(task, status)
        task["status"] = status
        if status == STATUS_DONE:
            task["completedTime"] = now_api_time()
        else:
            task.pop("completedTime", None)
        task["modifiedTime"] = now_api_time()
        holder["task"] = task
        return batch_task(session, update=[task])

    try:
        with_session(call)
    except TickTickError as error:
        if not error.transient and not error.needs_review:
            raise
        session = getattr(error, "session", None)
        if local_task is not None and (not session or session.get("backend") != "openapi"):
            ensure_completion_is_safe(local_task, status)
        payload = {"taskId": task_id, "completedTime": now_api_time()}
        if session and session.get("backend") == "openapi":
            local = cached_task(task_id)
            if local.get("repeatFlag") or local.get("repeatFrom") not in (None, "", 0, "0"):
                payload["expectedDueDate"] = local.get("dueDate")
            if error.needs_review:
                payload["needsReview"] = True
        queue_write("complete" if status == STATUS_DONE else "reopen", payload, str(error), session)
        if error.needs_review:
            raise TickTickError("Recurring completion was saved for review; check TickTick before retrying so the next occurrence is not skipped",
                                needs_review=True) from None
        holder["task"] = {"id": task_id, "queued": True}
    return holder["task"]


def apply_edit(task: dict, fields: dict) -> dict:
    """Overlay an edit onto a task. Absent keys are left alone.

    An empty tag list or a zero priority are edits, not omissions — clearing
    them is how the panel removes a tag or a flag — so the caller decides what
    to send rather than this guessing from falsiness.
    """
    edited = dict(task)
    if "title" in fields:
        edited["title"] = fields["title"]
    if "priority" in fields:
        edited["priority"] = int(fields["priority"] or 0)
    if "tags" in fields:
        edited["tags"] = [str(t).strip().lower() for t in (fields["tags"] or []) if str(t).strip()]
    if "due" in fields:
        edited.update(due_fields(fields["due"], fields.get("time")))
    edited["modifiedTime"] = now_api_time()
    return edited


def update_task(task_id: str, fields: dict) -> dict:
    holder = {}

    def call(session):
        edited = apply_edit(find_task(task_id, session), fields)
        holder["task"] = edited
        return batch_task(session, update=[edited])

    try:
        with_session(call)
    except TickTickError as error:
        if not error.transient:
            raise
        # Queued as the edit itself, not as the finished object: replaying it
        # re-fetches the task, so a change made elsewhere in the meantime
        # survives everything this edit did not touch.
        queue_write("update", {"taskId": task_id, "fields": fields}, str(error), getattr(error, "session", None))
        holder["task"] = {"id": task_id, "queued": True}
    return holder["task"]


def flip_subtask(task: dict, item_id: str) -> bool:
    """Toggle one subtask's checkbox in place. True when the id was found.

    Status 0 is open and 1 is done. completedTime travels with the status:
    a checked subtask carries when it was checked, an unchecked one forgets.
    """
    for item in task.get("items") or []:
        if str(item.get("id")) != item_id:
            continue
        done = int(item.get("status") or 0) != 0
        item["status"] = 0 if done else 1
        if done:
            item.pop("completedTime", None)
        else:
            item["completedTime"] = now_api_time()
        return True
    return False


def toggle_subtask(task_id: str, item_id: str) -> dict:
    """Flip one subtask of a task. v2 updates the whole task object."""
    holder = {}

    def call(session):
        task = dict(find_task(task_id, session))
        if not flip_subtask(task, item_id):
            raise TickTickError(f"Task {task_id} has no subtask {item_id}")
        if session.get("backend") == "openapi":
            holder["target"] = next(dict(item) for item in task["items"] if item.get("id") == item_id)
        task["modifiedTime"] = now_api_time()
        holder["item"] = {"id": item_id}
        return batch_task(session, update=[task])

    try:
        with_session(call)
    except TickTickError as error:
        if not error.transient:
            raise
        # Queued as the flip itself. Replaying re-fetches the task and toggles
        # whatever that subtask says now, so two rapid offline flips cancel
        # out on the server exactly as they did on screen.
        session = getattr(error, "session", None)
        payload = {"taskId": task_id, "itemId": item_id}
        if session and session.get("backend") == "openapi":
            if "target" not in holder:
                # The lookup itself failed. Base the desired checkbox on the
                # visible cache instead of guessing the server's state.
                task = cached_task(task_id)
                if not flip_subtask(task, item_id):
                    raise TickTickError("Checkbox is absent from the cache; sync before retrying") from None
                holder["target"] = next(dict(item) for item in task["items"] if item.get("id") == item_id)
            payload["item"] = holder["target"]
        queue_write("subtask", payload, str(error), session)
        holder["item"] = {"id": item_id, "queued": True}
    return holder["item"]


def delete_task(task_id: str) -> dict:
    """Remove a task outright. v2 wants the project id alongside the task id."""
    def call(session):
        task = find_task(task_id, session)
        if session.get("backend") == "openapi":
            return request("DELETE", f"/project/{_api_id(task.get('projectId'))}/task/{_api_id(task_id)}", session)
        return request(
            "POST",
            "/batch/task",
            session,
            payload={
                "add": [],
                "update": [],
                "delete": [{"taskId": task_id, "projectId": task.get("projectId", "")}],
            },
        )

    with_session(call)
    return {"id": task_id}


def create_task(
    title: str,
    project_id: str | None,
    due: str | None,
    priority: int = 0,
    tags: list | None = None,
    time_value: str | None = None,
) -> dict:
    cache = _read_json(DATA_PATH)
    task = {
        "id": object_id(),
        "projectId": project_id or cache.get("inboxId") or "",
        "title": title,
        "status": STATUS_TODO,
        # TickTick's own scale: 0 none, 1 low, 3 medium, 5 high.
        "priority": int(priority or 0),
        # Tasks reference tags by their lowercase name, not their label.
        "tags": [str(t).strip().lower() for t in (tags or []) if str(t).strip()],
        "sortOrder": -int(time.time() * 1000),
        "timeZone": local_timezone_name(),
        "isAllDay": True,
        "items": [],
        "createdTime": now_api_time(),
        "modifiedTime": now_api_time(),
    }
    if due:
        task.update(due_fields(due, time_value))

    def call(session):
        if session.get("backend") == "openapi":
            if not project_id:
                raise TickTickError("The Open API exposes no inbox ID; choose a project with --project to add a task")
            task["projectId"] = project_id
            task.update(openapi_create_task(session, task))
            return task
        return batch_task(session, add=[task])

    try:
        with_session(call)
    except TickTickError as error:
        session = getattr(error, "session", None)
        if (session and session.get("backend") == "openapi"
                and (error.transient or error.needs_review)):
            queue_write("add", {"task": task, "needsReview": True}, str(error), session)
            raise TickTickError(
                "Task creation could not be confirmed. The task was saved in the outbox for review; "
                "check TickTick before adding it again. Automatic retry could duplicate it.",
                needs_review=True,
            ) from None
        if not error.transient:
            raise
        # Legacy v2 preserves this client id, so replay targets the same task.
        queue_write("add", {"task": task}, str(error), session)
        task["queued"] = True
    return task


def local_timezone_name() -> str:
    try:
        with open("/etc/timezone", encoding="utf-8") as handle:
            name = handle.read().strip()
            if name:
                return name
    except OSError:
        pass
    link = "/etc/localtime"
    if os.path.islink(link):
        target = os.readlink(link)
        if "zoneinfo/" in target:
            return target.split("zoneinfo/", 1)[1]
    return "UTC"


def parse_due_date(value: str) -> datetime:
    """A due word as a local calendar date, at midnight."""
    text = value.strip().lower()
    today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    if text == "today":
        return today
    if text == "tomorrow":
        return today + timedelta(days=1)
    if text == "yesterday":
        return today - timedelta(days=1)
    try:
        return datetime.strptime(value.strip(), "%Y-%m-%d")
    except ValueError as error:
        raise TickTickError("--due wants today, tomorrow, yesterday, or YYYY-MM-DD") from error


def parse_due_argument(value: str) -> str:
    return parse_due_date(value).strftime("%Y-%m-%dT00:00:00.000+0000")


def parse_time_argument(value: str) -> tuple[int, int | None]:
    """'21:00' or '21:00-22:30' as minutes since midnight; end may be None."""
    text = value.strip()

    def one_clock(token: str) -> int | None:
        parts = token.split(":")
        if len(parts) != 2 or not all(p.isdigit() for p in parts):
            return None
        hour, minute = int(parts[0]), int(parts[1])
        if hour > 23 or minute > 59:
            return None
        return hour * 60 + minute

    halves = text.split("-")
    if len(halves) == 1:
        start = one_clock(halves[0].strip())
        if start is None:
            raise TickTickError("--time wants HH:MM or HH:MM-HH:MM")
        return start, None
    if len(halves) != 2:
        raise TickTickError("--time wants HH:MM or HH:MM-HH:MM")
    start, end = one_clock(halves[0].strip()), one_clock(halves[1].strip())
    if start is None or end is None:
        raise TickTickError("--time wants HH:MM or HH:MM-HH:MM")
    return start, end


def due_fields(due: str, time_value: str | None = None) -> dict:
    """The three date fields a task carries, from the edit grammar.

    A date alone is all-day at local midnight, as it always was. A clock
    turns it into a real instant in this machine's timezone: a lone time is
    a due hour, a range is a duration — and an end that is not after the
    start spills into the next day, because "23:30-00:30" means overnight,
    not nothing.
    """
    target = parse_due_date(due)
    if not time_value:
        stamp = target.strftime("%Y-%m-%dT00:00:00.000+0000")
        return {"dueDate": stamp, "startDate": stamp, "isAllDay": True}

    start_minutes, end_minutes = parse_time_argument(time_value)
    start_dt = target + timedelta(minutes=start_minutes)
    if end_minutes is None:
        stamp = to_api_time(start_dt)
        return {"dueDate": stamp, "startDate": stamp, "isAllDay": False}
    end_delta = timedelta(minutes=end_minutes - start_minutes)
    if end_minutes <= start_minutes:
        end_delta += timedelta(days=1)
    return {
        "startDate": to_api_time(start_dt),
        "dueDate": to_api_time(start_dt + end_delta),
        "isAllDay": False,
    }


def query_checkin(session: dict, habit_id: str, stamp: int) -> dict | None:
    if session.get("backend") == "openapi":
        rows = request("GET", "/habit/checkins", session,
                       params={"habitIds": habit_id, "from": stamp, "to": stamp})
        for entry in normalize_openapi_checkins(rows).get(habit_id, []):
            if entry["checkinStamp"] == stamp:
                return entry
        return None
    after = date_stamp(datetime.strptime(str(stamp), "%Y%m%d") - timedelta(days=1))
    response = request(
        "POST",
        "/habitCheckins/query",
        session,
        payload={"habitIds": [habit_id], "afterStamp": after},
    )
    entries = (response or {}).get("checkins", {}).get(habit_id, []) if isinstance(response, dict) else []
    for entry in entries:
        if entry.get("checkinStamp") == stamp:
            return entry
    return None


def check_in(habit: dict, stamp: int, value: float | None, toggle: bool) -> dict:
    habit_id = habit["id"]
    goal = float(habit.get("goal") or 1)
    step = float(habit.get("step") or goal or 1)

    pending = {}

    def call(session):
        official = session.get("backend") == "openapi"
        read_error = None
        try:
            existing = query_checkin(session, habit_id, stamp)
        except TickTickError as error:
            if not official or not error.transient:
                raise
            cache = _read_json(DATA_PATH)
            if cache.get("cacheOwner") != session_owner(session):
                raise
            existing = next((item for item in cache.get("checkins", {}).get(habit_id, [])
                             if item.get("checkinStamp") == stamp), None)
            read_error = error
        current = float(existing.get("value") or 0) if existing else 0.0

        if toggle and existing and (current >= goal if official else float(existing.get("status") or 0) == CHECKIN_DONE):
            new_value = 0.0
        elif value is not None:
            new_value = float(value)
        elif habit.get("type") == "Real" or official:
            # A quantified habit advances by its own step, so repeat clicks
            # walk 1/3, 2/3, 3/3 instead of jumping straight to complete.
            new_value = min(current + step, goal) if current < goal else 0.0
        else:
            new_value = goal

        entry = {
            "habitId": habit_id,
            "checkinStamp": stamp,
            "checkinTime": now_api_time(),
            "opTime": now_api_time(),
            "goal": goal,
            "value": new_value,
            "status": CHECKIN_DONE if new_value >= goal else CHECKIN_UNCHECKED,
        }
        pending["entry"] = entry
        if read_error is not None:
            raise read_error
        if official:
            request("POST", f"/habit/{_api_id(habit_id)}/checkin", session,
                    payload=openapi_checkin_body(entry))
            return entry

        payload = {"add": [], "update": [], "delete": []}
        if existing and existing.get("id"):
            entry["id"] = existing["id"]
            payload["update"].append(entry)
        else:
            payload["add"].append(entry)

        request("POST", "/habitCheckins/batch", session, payload=payload)
        return entry

    try:
        entry, _ = with_session(call)
    except TickTickError as error:
        if not error.transient:
            raise
        goal_value = float(habit.get("goal") or 1)
        entry = {
            "habitId": habit_id,
            "checkinStamp": stamp,
            "checkinTime": now_api_time(),
            "opTime": now_api_time(),
            "goal": goal_value,
            "value": value if value is not None else goal_value,
            "status": CHECKIN_DONE,
        }
        session = getattr(error, "session", None)
        if session and session.get("backend") == "openapi":
            if "entry" not in pending:
                raise TickTickError("Could not read the current habit value; retry after syncing") from None
            entry = pending["entry"]
        queue_write("checkin", {"entry": entry}, str(error), session)
        entry["queued"] = True
    return entry


# --------------------------------------------------------------------------
# commands


def consume_token_file(path: str, wait_seconds: float = 3.0) -> str:
    """Consume a private legacy handoff inside STATE_DIR, even on failure.

    New panels use stdin instead. Kept for older callers, with bounded,
    nonblocking, no-follow reads and cleanup before any network access.
    """
    if os.path.abspath(os.path.dirname(path)) != os.path.abspath(STATE_DIR):
        raise TickTickError("Token handoff must be inside the TickTick credential directory")
    with _ensure_state_dir() as directory:
        name = os.path.basename(path)
        deadline = time.monotonic() + wait_seconds
        try:
            while True:
                try:
                    fd = os.open(
                        name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                        dir_fd=directory,
                    )
                    with os.fdopen(fd, "rb") as handle:
                        info = os.fstat(handle.fileno())
                        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                                or info.st_mode & 0o077 or info.st_nlink != 1):
                            raise TickTickError("Token handoff must be an owned, private regular file")
                        raw = handle.read(4097)
                    if len(raw) > 4096:
                        raise TickTickError("Token handoff is too large")
                    token = raw.decode("utf-8").strip()
                    if token:
                        return token
                except FileNotFoundError:
                    pass
                except (OSError, UnicodeError):
                    raise TickTickError("Cannot read a safe TickTick token handoff") from None
                if time.monotonic() >= deadline:
                    raise TickTickError("No token was handed over; nothing to connect with")
                time.sleep(0.05)
        finally:
            with contextlib.suppress(FileNotFoundError, IsADirectoryError):
                os.unlink(name, dir_fd=directory)


def connect_with_token(raw_token: str, session: dict, email: str = "") -> dict:
    """Adopt a browser session token, proving it works before storing it."""
    token = raw_token.strip()
    if token.startswith("t="):
        token = token[2:].strip()
    if not token:
        raise TickTickError("That token was empty")
    if not _valid_token(token):
        raise TickTickError("That token is malformed; paste only the browser cookie value")

    candidate = {
        "token": token,
        "userId": session.get("userId", ""),
        "email": email or session.get("email", ""),
        "deviceId": device_id(session),
        "savedAt": int(time.time() * 1000),
        "source": "browser-cookie",
    }
    with account_lock():
        ensure_session_switch_safe(candidate)
        state = fetch_state(candidate)
        store_connection(candidate, state)
    return state


def store_connection(candidate: dict, state: dict) -> None:
    # Called under account_lock. Prepare the cache before publishing the
    # credential, so a failed cache write cannot leave a connected session.
    previous = _read_json(DATA_PATH)
    try:
        _write_private(DATA_PATH, state)
        for entry in read_outbox():
            apply_locally(entry["kind"], entry.get("payload") or {})
        _write_private(TOKEN_PATH, candidate)
    except OSError:
        with contextlib.suppress(OSError):
            _write_private(DATA_PATH, previous)
        raise TickTickError("Cannot save the TickTick connection; check state-directory permissions and free space") from None


def connect_with_api_token(raw_token: str, source: str = "api-token", token_response: dict | None = None) -> dict:
    token = raw_token.strip() if isinstance(raw_token, str) else ""
    if not _valid_token(token):
        raise TickTickError("That API token is empty or malformed; paste only the access token")
    response = token_response or {}
    if str(response.get("token_type", "Bearer")).lower() != "bearer":
        raise TickTickError("TickTick returned an unsupported token type")
    candidate = {"backend": "openapi", "source": source, "token": token,
                 "savedAt": int(time.time() * 1000)}
    if source == "oauth":
        candidate["clientId"] = response.get("client_id", "")
        if "expires_in" in response:
            try:
                seconds = int(response["expires_in"])
                if seconds <= 0:
                    raise ValueError
            except (TypeError, ValueError, OverflowError):
                raise TickTickError("TickTick returned an invalid token lifetime") from None
            candidate["expiresAt"] = candidate["savedAt"] + seconds * 1000
    with account_lock():
        ensure_session_switch_safe(candidate)
        state = fetch_state(candidate)
        state["queued"] = len(read_outbox())
        store_connection(candidate, state)
    return state


def cmd_oauth_login(args) -> int:
    # runpy/SourceFileLoader do not add the CLI's directory to sys.path.
    local_bin = os.path.dirname(os.path.realpath(__file__))
    if local_bin not in sys.path:
        sys.path.insert(0, local_bin)
    events = getattr(args, "json_events", False)
    browser_opened = False

    def emit(event):
        nonlocal browser_opened
        phase = event.get("phase")
        if phase not in ("preparing", "waiting", "validating"):
            raise TickTickError("Unexpected TickTick authorization phase")
        safe = {"phase": phase}
        if phase == "waiting":
            url = event.get("url", "")
            parsed = urllib.parse.urlsplit(url)
            if parsed.scheme != "https" or parsed.netloc != "ticktick.com" or parsed.path != "/oauth/authorize":
                raise TickTickError("TickTick returned an unsafe authorization URL")
            # Only authorization parameters belong in this public event.
            if any(key in urllib.parse.parse_qs(parsed.query) for key in
                   ("access_token", "token", "code", "code_verifier", "client_secret")):
                raise TickTickError("TickTick returned an unsafe authorization URL")
            safe["url"] = url
            if not events and not browser_opened:
                import subprocess
                try:
                    subprocess.run(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                   timeout=10, check=True)
                except (OSError, subprocess.SubprocessError):
                    raise TickTickError("Could not open the browser for TickTick authorization") from None
                browser_opened = True
        if events:
            print(json.dumps(safe), flush=True)

    try:
        from ticktick_oauth import authorize, OAuthError
    except ImportError:
        error = TickTickError("TickTick browser authorization module is unavailable")
        if events:
            print(json.dumps({"phase": "error", "code": "oauth_unavailable", "message": str(error)}), flush=True)
            return 1
        raise error from None
    try:
        # A new OAuth credential cannot prove account identity until consent.
        # Without a documented identity endpoint, do not migrate queued work.
        if read_outbox():
            raise TickTickError("Sync pending changes with the current TickTick connection before browser sign-in; cache and outbox preserved")
        response = authorize(emit, timeout=180)
        if not isinstance(response, dict):
            raise TickTickError("TickTick authorization returned no access token")
        connect_with_api_token(response.get("access_token"), "oauth", response)
    except (OAuthError, TickTickError) as error:
        if events:
            code = error.code if isinstance(error, OAuthError) else ("auth_required" if error.auth_required else "connection_failed")
            print(json.dumps({"phase": "error", "code": code, "message": str(error)}), flush=True)
            return 1
        raise TickTickError(str(error)) from None
    if events:
        print(json.dumps({"phase": "connected", "ok": True}), flush=True)
    else:
        print("Connected to TickTick.")
    return 0


def cmd_login(args) -> int:
    if getattr(args, "oauth", False):
        return cmd_oauth_login(args)
    if getattr(args, "json_events", False):
        raise TickTickError("--json-events requires --oauth")
    session = load_session()

    api_token = getattr(args, "api_token_stdin", False)
    if api_token or getattr(args, "token_stdin", False) or getattr(args, "token_file", None):
        if api_token or getattr(args, "token_stdin", False):
            raw_token = sys.stdin.readline(4097)
            if len(raw_token) > 4096:
                raise TickTickError("Token handoff is too large")
        else:
            raw_token = consume_token_file(args.token_file)
        state = (connect_with_api_token(raw_token) if api_token else
                 connect_with_token(raw_token, session, args.email or ""))
        print(json.dumps({
            "ok": True,
            "tasks": len(state["tasks"]),
            "habits": len(state["habits"]),
        }))
        return 0

    # Token path. Preferred, and the only one that works on an account whose
    # risk control has stopped trusting scripted password logins: the browser
    # already holds a valid session, so lift its `t` cookie instead of asking
    # TickTick to mint a second one. No password is involved at any point.
    if args.token:
        # `--token -` prompts instead, so a full-access credential never lands
        # in shell history.
        raw = getpass.getpass("TickTick `t` cookie: ") if args.token == "-" else args.token
        state = connect_with_token(raw, session, args.email or "")
        print(
            f"Connected with a browser session token: "
            f"{len(state['tasks'])} open tasks, {len(state['habits'])} habits."
        )
        return 0

    email = args.email or session.get("email") or input("TickTick email: ").strip()
    if not email:
        raise TickTickError("An email address is required")

    password = os.environ.get("TICKTICK_PASSWORD") or getpass.getpass("TickTick password: ")
    if not password:
        raise TickTickError("A password is required")

    with account_lock():
        if read_outbox():
            raise TickTickError("Sync pending changes with the current connection before signing in")
        # Password sign-in is always the explicit legacy backend.
        session = sign_in(email, password, {"deviceId": device_id(session)})
        state = fetch_state(session)
        store_connection(session, state)
    print(
        f"Signed in as {email}: {len(state['tasks'])} open tasks, {len(state['habits'])} habits."
    )
    return 0


def cmd_logout(_args) -> int:
    with account_lock():
        if read_outbox():
            raise TickTickError("Pending TickTick changes must be synced before logout; cache and outbox preserved")
        for path in (TOKEN_PATH, DATA_PATH, OUTBOX_PATH):
            try:
                os.remove(path)
            except OSError:
                pass
    print("Signed out of TickTick.")
    return 0


def cmd_sync(args) -> int:
    scope = getattr(args, "scope", None) or "full"

    # A bar surface exists per monitor, so every timer tick fires one sync per
    # screen. Skipping a sync whose work another instance just did halves the
    # request rate on a two-monitor desktop without any coordination between
    # them.
    max_age = getattr(args, "max_age", None)
    if max_age:
        cache = _read_json(DATA_PATH)
        synced_at = int(cache.get("syncedAt") or 0)
        age = (time.time() * 1000 - synced_at) / 1000
        if synced_at and age < float(max_age) and not read_outbox():
            print(json.dumps({"ok": True, "skipped": True, "ageSeconds": round(age)}))
            return 0
    outbox = {"sent": 0, "queued": len(read_outbox()), "dropped": 0}
    try:
        # Queued work goes out before anything is read back, so the sync that
        # follows reflects the writes rather than contradicting them.
        if outbox["queued"]:
            with drain_lock() as held:
                if held:
                    outbox, _ = with_session(drain_outbox)
                else:
                    # Another bar is delivering these right now.
                    outbox = dict(outbox, skippedDrain=True)
        state, _ = with_session(lambda session: fetch_state(session, scope))
    except TickTickError as error:
        write_error_cache(str(error), error.auth_required)
        raise
    state["queued"] = len(read_outbox())
    write_cache(state)
    print(json.dumps({
        "ok": True,
        "scope": scope,
        "tasks": len(state["tasks"]),
        "habits": len(state["habits"]),
        "queued": state["queued"],
        "sent": outbox.get("sent", 0),
        "dropped": outbox.get("dropped", 0),
    }))
    return 0


def sync_after_write(args, scope: str) -> None:
    """Refresh only what the write could have touched."""
    previous = getattr(args, "scope", None)
    args.scope = scope
    try:
        cmd_sync(args)
    finally:
        args.scope = previous


def queued_result(payload: dict) -> int:
    """A queued write succeeded from the user's side; only delivery is late."""
    print(json.dumps(dict(payload, ok=True, queued=True)))
    return 0


def cmd_complete(args) -> int:
    task = set_task_status(args.task_id, STATUS_DONE)
    if task.get("queued"):
        return queued_result({"completed": task["id"]})
    sync_after_write(args, "tasks")
    print(json.dumps({"ok": True, "completed": task["id"]}))
    return 0


def cmd_subtask(args) -> int:
    item = toggle_subtask(args.task_id, args.item_id)
    if item.get("queued"):
        return queued_result({"subtask": item["id"]})
    sync_after_write(args, "tasks")
    print(json.dumps({"ok": True, "subtask": item["id"]}))
    return 0


def cmd_update(args) -> int:
    fields = {}
    if args.title is not None:
        fields["title"] = args.title
    if args.priority is not None:
        fields["priority"] = args.priority
    if args.tags is not None:
        fields["tags"] = [t for t in args.tags.split(",") if t.strip()]
    if args.due is not None:
        fields["due"] = args.due
    if args.time is not None:
        fields["time"] = args.time
    if not fields:
        raise TickTickError("Nothing to update; pass --title, --due, --time, --priority or --tags")

    task = update_task(args.task_id, fields)
    if task.get("queued"):
        return queued_result({"updated": task["id"]})
    sync_after_write(args, "tasks")
    print(json.dumps({"ok": True, "updated": task["id"], "title": task.get("title")}))
    return 0


def cmd_delete(args) -> int:
    delete_task(args.task_id)
    sync_after_write(args, "tasks")
    print(json.dumps({"ok": True, "deleted": args.task_id}))
    return 0


def cmd_reopen(args) -> int:
    task = set_task_status(args.task_id, STATUS_TODO)
    if task.get("queued"):
        return queued_result({"reopened": task["id"]})
    sync_after_write(args, "tasks")
    print(json.dumps({"ok": True, "reopened": task["id"]}))
    return 0


def cmd_add(args) -> int:
    task = create_task(
        args.title,
        args.project,
        args.due,
        priority=args.priority,
        tags=(args.tags or "").split(",") if args.tags else None,
        time_value=args.time,
    )
    if task.get("queued"):
        return queued_result({"id": task["id"], "title": task["title"]})
    sync_after_write(args, "tasks")
    print(json.dumps({"ok": True, "id": task["id"], "title": task["title"]}))
    return 0


def cmd_checkin(args) -> int:
    habit = resolve_habit(args.habit)
    stamp = int(args.date) if args.date else date_stamp()
    entry = check_in(habit, stamp, args.value, args.toggle)
    if entry.get("queued"):
        return queued_result({"habit": habit.get("name")})
    sync_after_write(args, "habits")
    print(json.dumps({"ok": True, "habit": habit.get("name"), "value": entry["value"], "status": entry["status"]}))
    return 0


def cmd_pomo(args) -> int:
    if args.pomo_command == "status":
        cache = _read_json(DATA_PATH)
        print(json.dumps({"stats": cache.get("pomoStats", {}), "prefs": cache.get("pomoPrefs", {})}))
        return 0

    end = datetime.now(timezone.utc)
    start = end - timedelta(minutes=float(args.minutes))
    entry = log_pomodoro(start, end, args.pause_seconds, args.type)
    if entry.get("queued"):
        return queued_result({"id": entry["id"], "minutes": float(args.minutes)})
    sync_after_write(args, "pomo")
    print(json.dumps({"ok": True, "id": entry["id"], "minutes": float(args.minutes)}))
    return 0


def cmd_status(_args) -> int:
    cache = _read_json(DATA_PATH)
    print(
        json.dumps(
            {
                "signedIn": bool(load_session().get("token")),
                "syncedAt": cache.get("syncedAt"),
                "tasks": len(cache.get("tasks", [])),
                "habits": len(cache.get("habits", [])),
                "error": cache.get("error"),
                "authRequired": bool(cache.get("authRequired")),
                "queued": len(read_outbox()),
                "dataPath": DATA_PATH,
            }
        )
    )
    return 0


def _outbox_needs_review(entry) -> bool:
    return (isinstance(entry, dict) and isinstance(entry.get("payload"), dict)
            and entry["payload"].get("needsReview") is True)


def cmd_outbox(_args) -> int:
    """Inspect local intent, never credentials or arbitrary provider errors."""
    rows = []
    with account_lock():
        token = load_session().get("token")
        cache = _read_json(DATA_PATH)
        tasks = {task.get("id"): task.get("title", "") for task in cache.get("tasks", [])
                 if isinstance(task, dict) and isinstance(task.get("id"), str)}
        for raw in read_outbox():
            entry = raw if isinstance(raw, dict) else {}
            payload = entry.get("payload") if isinstance(entry.get("payload"), dict) else {}
            kind = entry.get("kind")
            if kind not in ("add", "complete", "reopen", "update", "subtask", "checkin", "pomo"):
                kind = "unknown"
            task = payload.get("task") if isinstance(payload.get("task"), dict) else {}
            fields = payload.get("fields") if isinstance(payload.get("fields"), dict) else {}
            task_id = payload.get("taskId")
            title = (task.get("title") or fields.get("title")
                     or (tasks.get(task_id) if isinstance(task_id, str) else "")
                     or ("Focus session" if kind == "pomo" else ""))
            title = title if isinstance(title, str) else ""
            entry_id = entry.get("id")
            if (not isinstance(entry_id, str) or len(entry_id) != 24
                    or any(char not in "0123456789abcdef" for char in entry_id)):
                entry_id = ""
            for secret in (token, entry.get("owner")):
                if isinstance(secret, str) and secret:
                    title = title.replace(secret, "[redacted]")
                    if entry_id == secret:
                        entry_id = ""
            review = _outbox_needs_review(entry)
            rows.append({"id": entry_id, "kind": kind, "title": title[:256], "needsReview": review,
                         # Historical lastError can contain untrusted replies.
                         "error": ("Unconfirmed write; check TickTick before discarding" if review
                                   else "Pending write; sync with its original connection")})
    print(json.dumps({"entries": rows}))
    return 0


def cmd_discard_reviewed(args) -> int:
    if not args.confirm:
        raise TickTickError("Check the reviewed writes in TickTick, then pass --confirm to discard only review entries")
    try:
        with account_lock():
            entries = read_outbox()
            remaining = [entry for entry in entries if not _outbox_needs_review(entry)]
            discarded = len(entries) - len(remaining)
            if discarded:
                write_outbox(remaining)
    except OSError:
        raise TickTickError("Cannot discard reviewed outbox entries; check private storage permissions and free space") from None
    print(json.dumps({"ok": True, "discarded": discarded, "remaining": len(remaining)}))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="omarchy-ticktick", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)

    login = sub.add_parser("login", help="authenticate and store a session token")
    login.add_argument("--email")
    tokens = login.add_mutually_exclusive_group()
    tokens.add_argument("--oauth", action="store_true", help="connect through browser authorization")
    tokens.add_argument("--api-token-stdin", action="store_true", help="read an official API token from stdin")
    tokens.add_argument("--token-stdin", action="store_true", help="read the token from stdin (used by the panel)")
    tokens.add_argument(
        "--token-file",
        help="private token file inside the credential directory; consumed and deleted",
    )
    login.add_argument("--json-events", action="store_true", help="stream browser authorization events as NDJSON")
    tokens.add_argument(
        "--token",
        help="session token lifted from the browser's `t` cookie; skips the password login entirely",
    )
    login.set_defaults(func=cmd_login)

    sub.add_parser("logout", help="forget the token and cache").set_defaults(func=cmd_logout)
    sync = sub.add_parser("sync", help="refresh the cache the panel reads")
    sync.add_argument(
        "--max-age",
        type=float,
        help="skip if the cache is younger than this many seconds and nothing is queued",
    )
    sync.add_argument(
        "--scope",
        choices=("full", "tasks", "habits", "pomo"),
        default="full",
        help="limit the refresh; sections outside the scope keep their cached values",
    )
    sync.set_defaults(func=cmd_sync)
    sub.add_parser("status", help="print cache state as JSON").set_defaults(func=cmd_status)

    outbox = sub.add_parser("outbox", help="inspect local pending writes without network access")
    outbox.set_defaults(func=cmd_outbox)
    outbox_commands = outbox.add_subparsers(dest="outbox_command")
    discard = outbox_commands.add_parser("discard-reviewed", help="discard only writes explicitly marked for review")
    discard.add_argument("--confirm", action="store_true", help="confirm you checked TickTick; discarded intent cannot be retried")
    discard.set_defaults(func=cmd_discard_reviewed)

    complete = sub.add_parser("complete", help="mark a task done")
    complete.add_argument("task_id")
    complete.set_defaults(func=cmd_complete)
    subtask = sub.add_parser("subtask", help="toggle one subtask's checkbox")
    subtask.add_argument("task_id")
    subtask.add_argument("item_id")
    subtask.set_defaults(func=cmd_subtask)

    edit = sub.add_parser("update", help="edit a task in place")
    edit.add_argument("task_id")
    edit.add_argument("--title")
    edit.add_argument("--due", help="today, tomorrow, yesterday, or YYYY-MM-DD")
    edit.add_argument("--time", help="HH:MM, or HH:MM-HH:MM for a duration")
    edit.add_argument("--priority", type=int, choices=(0, 1, 3, 5))
    edit.add_argument("--tags", help="comma-separated; an empty value clears them")
    edit.set_defaults(func=cmd_update)

    remove = sub.add_parser("delete", help="delete a task outright")
    remove.add_argument("task_id")
    remove.set_defaults(func=cmd_delete)

    reopen = sub.add_parser("reopen", help="mark a done task not-done")
    reopen.add_argument("task_id")
    reopen.set_defaults(func=cmd_reopen)

    add = sub.add_parser("add", help="create a task")
    add.add_argument("title")
    add.add_argument("--project", help="project id; required for Open API, defaults to inbox in legacy mode")
    add.add_argument("--due", help="today, tomorrow, yesterday, or YYYY-MM-DD")
    add.add_argument("--time", help="HH:MM, or HH:MM-HH:MM for a duration")
    add.add_argument(
        "--priority", type=int, default=0, choices=(0, 1, 3, 5),
        help="TickTick priority: 0 none, 1 low, 3 medium, 5 high",
    )
    add.add_argument("--tags", help="comma-separated tag names (lowercase, as TickTick stores them)")
    add.set_defaults(func=cmd_add)

    checkin = sub.add_parser("checkin", help="check a habit in")
    checkin.add_argument("habit", help="habit id or exact name")
    checkin.add_argument("--value", type=float, help="explicit value for quantified habits")
    checkin.add_argument("--date", help="YYYYMMDD; defaults to today")
    checkin.add_argument(
        "--toggle",
        action="store_true",
        help="clear the check-in when the day is already complete",
    )
    checkin.set_defaults(func=cmd_checkin)

    pomo = sub.add_parser("pomo", help="focus sessions")
    pomo_sub = pomo.add_subparsers(dest="pomo_command", required=True)
    pomo_sub.add_parser("status", help="today's focus stats and settings, from the cache")
    pomo_log = pomo_sub.add_parser("log", help="upload a finished focus session")
    pomo_log.add_argument("--minutes", type=float, required=True)
    pomo_log.add_argument("--pause-seconds", type=int, default=0)
    pomo_log.add_argument(
        "--type",
        type=int,
        default=0,
        help="0 for a pomodoro, 1 for an open-ended stopwatch session",
    )
    pomo_log.set_defaults(func=cmd_pomo)
    pomo_sub.choices["status"].set_defaults(func=cmd_pomo)

    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except TickTickError as error:
        print(json.dumps({"ok": False, "error": str(error), "authRequired": error.auth_required}), file=sys.stderr)
        return 3 if error.auth_required else 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
